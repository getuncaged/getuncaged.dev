---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProviderTicker from '../components/ProviderTicker.astro';
import Splits from '../components/Splits.astro';
import Modes from '../components/Modes.astro';
import Models from '../components/Models.astro';
import Themes from '../components/Themes.astro';
import Everything from '../components/Everything.astro';
import Engine from '../components/Engine.astro';
import Fork from '../components/Fork.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import { SITE, FAQ } from '../data/site';

// One JSON-LD graph for the one indexed page: the app itself, the site, the
// org behind it, and the FAQ (rich results + the primary food for AI search).
const ORG_ID = `${SITE.url}/#org`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'Uncaged contributors',
      url: SITE.url,
      logo: `${SITE.url}/mark-1024.png`,
      sameAs: [SITE.github, SITE.githubOrg],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      publisher: { '@id': ORG_ID },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.url}/#app`,
      name: SITE.name,
      url: SITE.url,
      description: SITE.descriptionLong,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Terminal emulator',
      operatingSystem: 'macOS, Linux, Windows',
      softwareVersion: SITE.version,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      downloadUrl: SITE.releasesLatest,
      screenshot: `${SITE.url}/og.png?v=2`,
      image: `${SITE.url}/og.png?v=2`,
      author: { '@id': ORG_ID },
      sameAs: [SITE.github],
      featureList: [
        'Agent Mode on any model — local runtime, API key, or CLI agent over ACP',
        'No account, no login, no cloud relay',
        'No telemetry, analytics or crash reporter: the code is removed, not switched off',
        'Local code search, shared with Claude Code, Gemini CLI and Codex over MCP',
        'About 0.01% CPU and 150 MB for an idle window',
        'Grouped and pinned tabs',
        'Split panes as cards: split and arrange from the tab menu, drag a tab onto a pane',
        'One input with a Terminal / Agent Mode switch (⌘I)',
        'Blocks, workflows, keymaps, IDE-grade editing kept from Warp',
        'GPU-fast rendering',
        '23 built-in themes, a community theme library, and a custom theme editor',
        'Opt-in updates verified against the GitHub release checksum',
        'Built to fork — links, marks and the model gallery live in a thin brand layer',
      ],
      keywords:
        'terminal, terminal app, terminal emulator, open source terminal, warp terminal, warp alternative, agentic terminal, AI terminal',
    },
    {
      '@type': 'FAQPage',
      '@id': `${SITE.url}/#faq`,
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/`/g, '') },
      })),
    },
  ],
});
---

<Base>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <Nav />
  <main id="main">
    <Hero />
    <ProviderTicker />
    <Splits />
    <Modes />
    <Models />
    <Themes />
    <Everything />
    <Engine />
    <Fork />
    <Install />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
