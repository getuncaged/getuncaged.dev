      gap: 4px;
      font-size: 10.5px;
    }
  }
  @media (max-width: 400px) {
    /* room for the model name: the context ring steps aside on the narrowest phones */
    .foot-right > .foot-btn:first-child {
      display: none;
    }
  }
</style>

<script>
  // Replays the scene: focus hops pane to pane and the tab title follows it, the
  // terminal types, the local model streams its answer, then the active model is
  // switched to Claude Code (every agent pane's chip changes, as the chip shows
  // the engine's one active connection) and Claude Code streams its answer.
  // Everything is already in the DOM (no-JS and reduced-motion see the finished frame).
  const root = document.querySelector<HTMLElement>('.live');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const panes = [...root.querySelectorAll<HTMLElement>('.pane')];
    const tab = root.querySelector<HTMLElement>('.lv-tab.is-on');
    const tabTitle = root.querySelector<HTMLElement>('[data-tab-title]');
    const chips = [...root.querySelectorAll<HTMLElement>('[data-model]')];
    const typed = root.querySelector<HTMLElement>('[data-type-a]');
    const commands = ['cargo run --release', 'git push origin v0.3.5', 'uncaged --version'];
    const models = { local: root.dataset.localModel ?? '', claude: root.dataset.claudeModel ?? '' };

    // each agent pane's status: 'done' (green check) or 'run' (clock-loader)
    const status = new Map<HTMLElement, string>();
    panes.forEach((p) => p.hasAttribute('data-agent') && status.set(p, 'done'));
    let focused = 0;

    const paintTab = () => {
      const p = panes[focused];
      if (tabTitle) tabTitle.textContent = p.dataset.tab ?? '';
      if (tab) tab.dataset.status = status.get(p) ?? '';
    };
    const setStatus = (p: HTMLElement, s: string) => {
      status.set(p, s);
      const h = p.querySelector<HTMLElement>('.pane-h-agent');
      if (h) h.dataset.status = s;
      if (panes[focused] === p) paintTab();
    };
    status.forEach((s, p) => setStatus(p, s));

    const focus = (ix: number) => {
      // the mode switches read focus from the pane's class (see the .mode rules)
      focused = ix;
      panes.forEach((p, i) => p.classList.toggle('is-focused', i === ix));
      paintTab();
    };
    paintTab();

    if (!reduce) {
      let cmdIx = 0;
      let visible = true;
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      // off-screen the loop parks on a promise the observer resolves: no timers while hidden
      let wake: (() => void) | null = null;
      const waitVisible = () => (visible ? Promise.resolve() : new Promise<void>((r) => (wake = r)));

      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible && wake) {
            wake();
            wake = null;
          }
        },
        { threshold: 0.1 }
      ).observe(root);

      // split each answer into word tokens once; streaming reveals them in place,
      // so nothing reflows while the text arrives
      const streams = new Map<HTMLElement, HTMLElement[]>();
      panes.forEach((p) => {
        const el = p.querySelector<HTMLElement>('[data-stream]');
        if (!el) return;
        const parts: string[] = [];
        el.childNodes.forEach((n) => {
          if (n.nodeType === 3) {
            for (const w of (n.textContent ?? '').split(/(\s+)/)) {
              if (!w) continue;
              parts.push(/^\s+$/.test(w) ? w : `<span class="tk">${w.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`);
            }
          } else parts.push(`<span class="tk">${(n as HTMLElement).outerHTML}</span>`);
        });
        el.innerHTML = parts.join('');
        streams.set(p, [...el.querySelectorAll<HTMLElement>('.tk')]);
      });

      const setModel = async (name: string) => {
        if (chips[0]?.textContent === name) return;
        chips.forEach((c) => c.classList.add('is-swapping'));
        await sleep(200);
        chips.forEach((c) => {
          c.textContent = name;
          c.classList.remove('is-swapping');
        });
      };

      const type = async (el: HTMLElement, text: string) => {
        el.textContent = '';
        for (const ch of text) {
          el.textContent += ch;
          await sleep(38 + Math.random() * 50);
        }
      };

      const streamIn = async (p: HTMLElement) => {
        const tokens = streams.get(p) ?? [];
        const fb = p.querySelector<HTMLElement>('.fb');
        setStatus(p, 'run');
        fb?.classList.add('is-hidden');
        tokens.forEach((t) => t.classList.add('is-hidden'));
        await sleep(500);
        for (const t of tokens) {
          t.classList.remove('is-hidden');
          await sleep(45 + Math.random() * 40);
        }
        fb?.classList.remove('is-hidden');
        setStatus(p, 'done');
      };

      const loop = async () => {
        await sleep(2200);
        while (true) {
          await waitVisible();
          focus(0);
          await setModel(models.local);
          if (typed) await type(typed, commands[cmdIx++ % commands.length]);
          await sleep(1600);
          await waitVisible();
          focus(1);
          await streamIn(panes[1]);
          await sleep(2400);
          await waitVisible();
          focus(2);
          await sleep(500);
          await setModel(models.claude);
          await sleep(500);
          await streamIn(panes[2]);
          await sleep(3200);
        }
      };
      loop();
    }
  }
</script>
