</style>

<script>
  // Total downloads, from GitHub's release counters via /api/downloads.json (cached at the edge).
  // Shown only when it loads; never a placeholder 0.
  const dlTotal = document.querySelector<HTMLElement>('[data-dl-total]');
  if (dlTotal) {
    fetch('/api/downloads.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((d: { total?: number | null } | null) => {
        if (!d || typeof d.total !== 'number' || d.total <= 0) return;
        dlTotal.textContent = `${d.total.toLocaleString('en-US')} downloads`;
        dlTotal.hidden = false;
      })
      .catch(() => {});
  }

  const root = document.querySelector<HTMLElement>('[data-inst]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    const flagOverflow = (scope: ParentNode) => {
      scope.querySelectorAll<HTMLElement>('.in-cmd > code').forEach((el) => {
        el.classList.toggle('is-overflowing', el.scrollWidth > el.clientWidth + 1);
      });
    };

    const select = (tab: HTMLButtonElement, focus: boolean) => {
      const os = tab.dataset.os ?? 'macos';
      root.dataset.os = os;
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      let shown: HTMLElement | undefined;
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== os;
        if (!p.hidden) shown = p;
      });
      if (focus) tab.focus();
      if (shown) {
        flagOverflow(shown);
        if (!reduce.matches) {
          const line = shown.querySelector<HTMLElement>('.in-t');
          if (line) {
            line.classList.remove('is-typing');
            void line.offsetWidth;
            line.classList.add('is-typing');
          }
        }
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });

    const refresh = () => panels.forEach((p) => !p.hidden && flagOverflow(p));
    refresh();
    window.addEventListener('resize', refresh, { passive: true });
    document.fonts?.ready.then(refresh);
  }
</script>
