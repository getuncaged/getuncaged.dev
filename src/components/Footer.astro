---
import Logo from './Logo.astro';
import { SITE } from '../data/site';

const year = new Date().getFullYear();
const doc = (p: string) => `${SITE.github}/blob/main/${p}`;
const cols = [
  {
    h: 'product',
    links: [
      { href: '#splits', label: 'splits' },
      { href: '#modes', label: 'two modes' },
      { href: '#models', label: 'any model' },
      { href: '#themes', label: 'themes' },
      { href: '#engine', label: 'no cloud' },
      { href: '#install', label: 'install' },
    ],
  },
  {
    h: 'source',
    links: [
      { href: SITE.github, label: 'github', ext: true },
      { href: SITE.releases, label: 'releases', ext: true },
      { href: SITE.issues, label: 'issues', ext: true },
      { href: 'https://github.com/sponsors/antonarnaudov', label: 'sponsor', ext: true },
    ],
  },
  {
    h: 'docs',
    links: [
      { href: doc('UNCAGED.md'), label: 'connect a model', ext: true },
      { href: doc('docs/migrate-from-warp.md'), label: 'migrate from warp', ext: true },
      { href: doc('FORKING.md'), label: 'fork & rebrand', ext: true },
      { href: doc('CONTRIBUTING.md'), label: 'contributing', ext: true },
    ],
  },
];
---

<footer class="footer">
  <div class="container">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="#top" class="foot-logo" aria-label="Back to top">
          <Logo idp="foot" size={26} />
          <span>uncaged</span>
        </a>
        <p class="foot-tag">The open-source agentic terminal with the cloud cut out. Free, local, built to be forked.</p>
      </div>
      {
        cols.map((c) => (
          <nav class="foot-col" aria-label={c.h}>
            <h3>{c.h}</h3>
            {c.links.map((l) => (
              <a href={l.href} {...(l.ext ? { rel: 'noopener' } : {})}>
                {l.label}
                {l.ext && <span aria-hidden="true"> ↗</span>}
              </a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="foot-word" aria-hidden="true">uncaged</div>

    <div class="foot-bottom">
      <p>© {year} Uncaged contributors · AGPL-3.0 (UI crates MIT) · {SITE.handle}</p>
      <p class="foot-legal">
        An independent fork of the open-source Warp client (© Denver Technologies, Inc.). Warp is a trademark of
        Denver Technologies, Inc. Uncaged is not affiliated with or endorsed by Warp.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--rule-strong);
    padding-top: 72px;
    overflow: hidden;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .foot-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 800 18px/1 var(--mono);
    letter-spacing: -0.02em;
  }
  .foot-tag {
    margin-top: 16px;
    max-width: 34ch;
    color: var(--ash);
    font-size: 15px;
  }
  .foot-col {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .foot-col h3 {
    margin-bottom: 6px;
    font: 700 11.5px/1 var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .foot-col a {
    width: fit-content;
    font: 500 14px/1.4 var(--mono);
    color: var(--ash);
    transition: color var(--fast);
  }
  .foot-col a:hover {
    color: var(--ember);
  }
  /* the wordmark, stamped across the full width */
  .foot-word {
    margin-top: 72px;
    font: 800 clamp(56px, 24.5vw, 370px) / 0.78 var(--mono);
    letter-spacing: -0.07em;
    text-transform: uppercase;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px rgba(232, 235, 242, 0.2);
    background: linear-gradient(180deg, rgba(232, 235, 242, 0.06), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    white-space: nowrap;
    margin-inline: -0.06em;
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0 28px;
    border-top: 1px solid var(--rule);
    font: 500 12.5px/1.6 var(--mono);
    color: var(--ash);
  }
  .foot-legal {
    max-width: 62ch;
    text-align: right;
  }
  @media (max-width: 860px) {
    .foot-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
    .foot-bottom {
      flex-direction: column;
    }
    .foot-legal {
      text-align: left;
    }
  }
</style>
