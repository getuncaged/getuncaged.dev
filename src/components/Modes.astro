---
/**
 * 02 · modes — one input, two modes. A working model of the input card.
 *
 * Built from the app's own source (uncaged v0.3.3, blocks per v0.3.5), with its real icons (AppIcon):
 *   switch: two square outlined segments, `terminal` / `sparkle`; the selected one is filled with
 *   its accent (normal blue / normal yellow) and its icon drawn in the background colour; the
 *   other is a grey icon, no fill. Tooltips "Terminal" / "Agent Mode" + the keybinding only.
 *                                    app/src/terminal/universal_developer_input.rs:399-525
 *   ⌘I · Ctrl-I, "Set Input Mode to Agent Mode" / "…Terminal Mode"
 *                                    app/src/terminal/view/init.rs:1144-1162
 *   placeholders "Run a command" / "Ask the agent" (fresh pane) / "Ask a follow up" (with a
 *   conversation; the context-usage button only appears then too)   app/src/terminal/input.rs:402-403
 *   context chips: `folder` + path, `git-branch-02` + branch (no ±0 chip in a clean repo); the
 *   conversation: your turn as an accent `chevron-right` in the avatar slot (uncaged-0.3
 *   common.rs render_user_avatar), `dots-vertical`, `thumbs-up`/`thumbs-down`/
 *   `arrow-split` (ai/blocklist/block/view_impl/common.rs:3490, output.rs:3124-3260).
 *   Layout and colours checked against the v0.3.3 captures split-3-z*.png / split-agent-empty.png.
 *   agent footer: left = switch, `nld` toggle (grey off, blue on, "Enable/Disable terminal
 *   command autodetection"); right = `conversation-context-0` "Context window usage", the model
 *   chip, `plus` "Attach file"   app/src/ai/blocklist/agent_view/agent_input_footer/mod.rs
 *   autodetection defaults false     app/src/settings/ai.rs:796, 820-842
 *   model chip "{model} │ {Level} effort", tooltip "Choose an agent model"
 *                                    app/src/terminal/profile_model_selector.rs:89, 255-298
 * The git log lines are real v0.3.5 history; v0.3.4..v0.3.5 is 143 commits (git rev-list --count).
 */
import AppIcon from './AppIcon.astro';
---

<section class="section md" id="modes" aria-labelledby="modes-h" data-modes>
  <div class="container">
    <span class="sec-tag"><b>02</b> modes</span>

    <div class="sec-head">
      <div>
        <p class="eyebrow">One input, two modes</p>
        <h2 class="h2" id="modes-h">⌘I<span class="ember">.</span><br /><span class="dim">That’s the switch.</span></h2>
      </div>
      <p class="lede">
        Terminal mode and Agent mode share <strong>one input box</strong>. Switching leaves everything where it is;
        only the buttons that belong to a mode come and go.
      </p>
    </div>

    <div class="md-stage" data-stage data-now="terminal">
      <!-- giant typographic halves; decoration (the real control is the switch in the card) -->
      <div class="md-words" aria-hidden="true">
        <div class="md-half md-half-t" data-pick="terminal">
          <span class="md-k"><AppIcon name="terminal" size={24} /></span>
          <span class="md-w">Terminal</span>
          <span class="md-sub">Runs in your shell.</span>
        </div>
        <div class="md-half md-half-a" data-pick="agent">
          <span class="md-k"><AppIcon name="sparkle" size={28} /></span>
          <span class="md-w">Agent</span>
          <span class="md-sub">Asks the model you connected.</span>
        </div>
      </div>

      <!-- the pane + its input card -->
      <div class="md-app" role="group" aria-label="Uncaged input, interactive. Use the mode switch, or press Command-I or Control-I while this section is on screen.">
        <div class="md-out" data-out>
          <!-- terminal blocks, 0.3.5 one-line headers: the prompt `<path> git:(<branch>) ❯` in front of the
               command (its name highlighted green) on one row (both commands here take under a second, so
               no duration shows), then the output; a thin rule between blocks -->
          <div class="out-t" data-out-t>
            <div class="blk blk-prev">
              <div class="blk-h" data-blkh><span class="blk-meta" data-p>~/code/uncaged git:(main)<span class="bh-sep"> ❯</span></span><span class="blk-cmd" data-c><b class="cn">git</b> describe --tags</span></div>
              <div class="blk-out"><span>v0.3.5</span></div>
            </div>
            <div class="blk">
              <div class="blk-h" data-blkh><span class="blk-meta" data-p>~/code/uncaged git:(main)<span class="bh-sep"> ❯</span></span><span class="blk-cmd" data-c><b class="cn">git</b> log --oneline -4</span></div>
              <div class="blk-out" data-lines tabindex="0" role="region" aria-label="git log output, scrolls sideways">
                <span><i class="y">334035f5 (</i><b class="hd">HEAD -&gt;</b> <b class="gn">main</b><i class="y">,</i> <b class="y">tag: v0.3.5</b><i class="y">)</i> uncaged: version 0.3.5 and its release notes</span>
                <span><i class="y">a45f2215</i> uncaged: reuse wgpu instance buffers across frames</span>
                <span><i class="y">ed50dafe</i> uncaged: crash-recovery watchdog blocks on a pidfd on Linux</span>
                <span><i class="y">c7d20a46</i> uncaged: file-watcher debouncers sleep until an event arrives</span>
              </div>
            </div>
          </div>
          <!-- agent conversation: the query line (accent prompt chevron, bold mono text, ⋮), the reply in mono indented to
               the query text with inline code in green, the rating/fork icons, then the hint row -->
          <div class="out-a" data-out-a hidden>
            <div class="q">
              <span class="q-av"><AppIcon name="chevron-right" size={14} /></span>
              <span class="q-t">What changed in 0.3.5?</span>
              <span class="q-more"><AppIcon name="dots-vertical" size={14} /></span>
            </div>
            <p class="a" data-stream>143 commits in <code>v0.3.4..v0.3.5</code>. The Warp account, cloud and telemetry code is removed, so an idle window drops to about 0.01% CPU and the download is a third smaller. Blocks get one-line headers, and grouped and pinned tabs are on.</p>
            <div class="a-acts" data-acts>
              <AppIcon name="thumbs-up" size={13} /><AppIcon name="thumbs-down" size={13} /><AppIcon name="arrow-split" size={13} />
            </div>
            <div class="hints" data-hints>
              <span><kbd>?</kbd> for help</span>
              <span><kbd>/</kbd> for commands</span>
              <span><kbd>⇧</kbd><kbd>⌘</kbd><kbd>+</kbd> for code review</span>
            </div>
          </div>
        </div>

        <div class="inp" data-inp>
          <div class="inp-chips" aria-hidden="true">
            <span class="ic"><AppIcon name="folder" size={13} />~/code/uncaged</span><span class="ic"><AppIcon name="git-branch-02" size={13} />main</span>
          </div>
          <div class="inp-line">
            <span class="ln" data-line></span><span class="ph" data-ph>Run a command</span><span class="caret" aria-hidden="true"></span>
          </div>
          <div class="inp-foot">
            <div class="mode" role="group" aria-label="Input mode">
              <button type="button" class="m-t" data-set="terminal" aria-pressed="true" aria-label="Terminal" title="Terminal (⌘I)"><AppIcon name="terminal" size={14} /></button>
              <button type="button" class="m-a" data-set="agent" aria-pressed="false" aria-label="Agent Mode" title="Agent Mode (⌘I)"><AppIcon name="sparkle" size={14} /></button>
            </div>
            <!-- agent footer, left: the autodetect toggle sits right after the switch -->
            <div class="foot-l" data-agent-only hidden>
              <button type="button" class="fb nld" data-nld aria-pressed="false" aria-label="Enable terminal command autodetection" title="Enable terminal command autodetection"><AppIcon name="nld" size={14} /></button>
            </div>
            <!-- agent footer, right: context usage (only once the pane has a conversation), model chip, attach -->
            <div class="foot-r" data-agent-only hidden>
              <span class="fb" data-ctx hidden title="Context window usage"><AppIcon name="conversation-context-0" size={14} label="Context window usage" /></span>
              <span class="model-chip" title="Choose an agent model">
                <span class="mc-m">opus[1m]</span><span class="sep" aria-hidden="true"></span><span class="mc-e">Medium effort</span>
                <AppIcon name="chevron-down" size={11} />
              </span>
              <span class="fb" title="Attach file"><AppIcon name="plus" size={14} label="Attach file" /></span>
            </div>
          </div>
        </div>
      </div>

      <p class="md-status" data-status aria-live="polite">
        <span data-status-text>Terminal mode. The line runs in your shell.</span>
      </p>
    </div>

    <ul class="md-facts">
      <li>
        <span class="f-k"><kbd data-kbd>⌘I</kbd></span>
        <span class="f-v">Switches both ways. Ctrl-I on Linux and Windows.</span>
      </li>
      <li>
        <span class="f-k"><span class="f-nld"><AppIcon name="nld" size={14} label="Autodetection toggle" /></span></span>
        <span class="f-v">The “A” button next to the switch. Off by default; turn it on and shell commands typed into agent input run in your shell.</span>
      </li>
      <li>
        <span class="f-k"><b class="f-chip">model <i></i> effort</b></span>
        <span class="f-v">The model chip carries effort: Low to Max on Anthropic, Low to High on OpenAI-compatible endpoints.</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* ================= the split stage ================= */
  .md-stage {
    --seam: rgba(232, 235, 242, 0.12);
    position: relative;
    isolation: isolate;
    padding-bottom: 8px;
  }
  .md-words {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  /* the seam between the halves, on the words only (it used to run on behind the card) */
  .md-half-t {
    border-right: 1px solid var(--seam);
  }
  .md-half {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(18px, 2.4vw, 32px) clamp(14px, 2vw, 28px) clamp(26px, 3.4vw, 52px);
    min-width: 0;
    cursor: pointer;
  }
  .md-half-a {
    align-items: flex-end;
    text-align: right;
  }
  /* the mode's real icon, lit in the switch's accent while that mode is on */
  .md-k {
    display: flex;
    align-items: center;
    height: 24px;
    color: var(--muted);
    transition: color 0.45s var(--ease);
  }
  .md-w {
    display: block;
    font: 800 clamp(26px, 6.7vw, 109px) / 0.82 var(--mono);
    letter-spacing: -0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(232, 235, 242, 0.45);
    transition:
      color 0.45s var(--ease),
      -webkit-text-stroke-color 0.45s var(--ease),
      transform 0.6s var(--ease-snap);
    transform-origin: left bottom;
    transform: scale(0.94);
  }
  .md-half-a .md-w {
    transform-origin: right bottom;
    margin-right: -0.04em;
  }
  .md-half-t .md-w {
    margin-left: -0.05em;
  }
  .md-sub {
    font: 500 13.5px/1.55 var(--mono);
    color: var(--muted);
    transition: color 0.45s;
  }
  [data-now='terminal'] .md-half-t .md-w {
    color: var(--ink);
    -webkit-text-stroke-color: transparent;
    transform: none;
  }
  [data-now='agent'] .md-half-a .md-w {
    color: var(--ember);
    -webkit-text-stroke-color: transparent;
    transform: none;
  }
  [data-now='terminal'] .md-half-t .md-sub,
  [data-now='agent'] .md-half-a .md-sub {
    color: var(--ash);
  }
  [data-now='terminal'] .md-half-t .md-k {
    color: var(--t-blue);
  }
  [data-now='agent'] .md-half-a .md-k {
    color: var(--gold);
  }

  /* ================= the pane + input card ================= */
  /* colours measured from the v0.3.3 captures (split-3-z.png, split-agent-empty.png) */
  .md-app {
    --pane: #0e1016;
    --card: #16181d;
    --card-line: #24262c;
    --ctl: #191b21;
    --ctl-line: #2f3136;
    --sw: #1f2126;
    --sw-line: #33353a;
    --chip-ink: #acdedb;
    --ph: #6a6c71;
    --dim: #919399;
    --ink-a: #d3d5da;
    --ink-t: #e8ebf1;
    --on-blue: #6da4f8;
    --on-yellow: #f4b554;
    --c-green: #76d198;
    --c-teal: #79d3c4;
    --c-yellow: #f4b554;
    position: relative;
    max-width: 880px;
    margin: 0 auto;
    padding: 6px 10px 10px;
    border-radius: 16px;
    border: 1px solid var(--bar);
    background: var(--pane);
    box-shadow:
      inset 0 1px 0 rgba(232, 235, 242, 0.06),
      0 40px 120px -40px rgba(0, 0, 0, 0.95),
      0 0 0 1px rgba(0, 0, 0, 0.6);
    font-family: var(--mono);
    /* the app draws `->` as two glyphs */
    font-variant-ligatures: none;
  }
  /* blocks sit on the input, newest last, as the app's block list does */
  .md-out {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 238px;
    padding: 6px 10px 0;
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent 0, #000 16px);
  }
  /* the agent's answer streams downward from the top, so a growing reply moves nothing above it */
  .out-a {
    margin-bottom: auto;
  }
  .out-t[hidden],
  .out-a[hidden],
  [data-agent-only][hidden],
  [data-ctx][hidden] {
    display: none;
  }
  .blk {
    padding: 10px 0 8px;
    border-bottom: 1px solid rgba(60, 67, 82, 0.35);
    font-size: 13px;
    line-height: 1.6;
  }
  /* one row: prompt ❯ command; it wraps (prompt above) when the command doesn't fit */
  .blk-h {
    margin-bottom: 4px;
  }
  .blk-meta {
    color: var(--dim);
  }
  .blk-cmd {
    font-weight: 700;
    color: var(--ink-t);
  }
  .blk-cmd .cn {
    color: var(--c-green);
  }
  .blk-out {
    display: grid;
    color: var(--ink-t);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .blk-out::-webkit-scrollbar {
    display: none;
  }
  .blk-out span {
    white-space: pre;
  }
  .blk-out i {
    font-style: normal;
  }
  .blk-out:focus-visible {
    outline-offset: 2px;
  }
  .blk-prev {
    padding-top: 0;
  }
  /* git log: hash and decoration parens yellow; HEAD -> teal, branch green, tag yellow, all bold */
  .y {
    color: var(--c-yellow);
  }
  .hd {
    color: var(--c-teal);
  }
  .gn {
    color: var(--c-green);
  }

  /* the query line: accent prompt chevron, bold mono text, ⋮ at the far right */
  .q {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 16px 0 10px;
    font: 700 13px/1.5 var(--mono);
    color: var(--ink-a);
  }
  .q-av {
    flex: none;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: var(--ember-app, #ee8138);
  }
  .q-t {
    flex: 1;
    min-width: 0;
  }
  .q-more {
    flex: none;
    display: grid;
    margin-top: 2px;
    color: var(--dim);
  }
  .a {
    margin: 0 0 0 26px;
    font: 400 13px/1.55 var(--mono);
    color: var(--ink-a);
  }
  /* global: the streamed reply creates its <code> at runtime */
  .a :global(code) {
    font: inherit;
    padding: 0;
    background: none;
    border: 0;
    color: var(--c-green);
  }
  .a-acts {
    display: flex;
    gap: 9px;
    margin: 14px 0 0 2px;
    color: #808388;
  }
  .hints {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 18px;
    font: 400 12px/1.4 var(--sans);
    color: var(--dim);
  }
  .hints span {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    white-space: nowrap;
  }
  .hints kbd {
    display: inline-grid;
    place-items: center;
    min-width: 15px;
    height: 15px;
    margin: 0 2px 0 0;
    padding: 0 3px;
    border: 0;
    border-radius: 999px;
    background: #2f3136;
    box-shadow: none;
    font: 600 10px/1 var(--sans);
    color: var(--ink-t);
  }

  /* the input card; this card is the focused pane's, so it sits on the lighter ground */
  .inp {
    padding: 12px 14px 11px;
    border-radius: 10px;
    border: 1px solid var(--card-line);
    background: var(--card);
  }
  .inp-chips {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  /* context chips: icon + text in mono, bold, light tint, each in a rounded outlined chip */
  .ic {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 21px;
    padding: 0 7px 0 6px;
    border: 1px solid var(--ctl-line);
    border-radius: 5px;
    background: var(--ctl);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--chip-ink);
    white-space: nowrap;
  }
  .ic svg {
    color: var(--dim);
  }
  .inp-line {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 26px;
    font-size: 14px;
    color: var(--ink-t);
    white-space: nowrap;
    overflow: hidden;
  }
  .ln:empty {
    display: none;
  }
  .ph {
    color: var(--ph);
  }
  .ln:not(:empty) + .ph {
    display: none;
  }
  /* the editor's default cursor is a bar, in the theme's gold */
  .caret {
    flex: none;
    width: 2px;
    height: 17px;
    margin-left: 1px;
    background: var(--gold);
    animation: blink 1.1s steps(1) infinite;
  }
  .ln:empty ~ .caret {
    order: -1;
    margin: 0 1px 0 0;
  }
  .inp-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    min-height: 22px;
    min-width: 0;
  }

  /* the switch: one rounded, outlined group with two segments. This card is the focused pane, so
     the selected segment is filled with its accent (terminal blue / yellow) and its icon drawn
     dark; the other is a grey icon with no fill. */
  .mode {
    flex: none;
    display: inline-flex;
    padding: 1px;
    border: 1px solid var(--sw-line);
    border-radius: 6px;
    background: var(--sw);
  }
  .mode button {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 18px;
    border-radius: 4px;
    color: #95979d;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.15s var(--ease);
  }
  .mode button:hover {
    color: var(--ink-t);
  }
  .mode button:focus-visible {
    outline-offset: 1px;
  }
  .mode .m-t[aria-pressed='true'] {
    color: #0f1116;
    background: var(--on-blue);
  }
  .mode .m-a[aria-pressed='true'] {
    color: #31291e;
    background: var(--on-yellow);
  }
  .mode button.is-press {
    transform: scale(0.86);
  }
  .foot-l,
  .foot-r {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    animation: pop 0.4s var(--ease) both;
  }
  .foot-l {
    flex: none;
  }
  .foot-r {
    margin-left: auto;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
  }
  /* the footer's square, outlined icon buttons, the model chip's height */
  .fb {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 5px;
    border: 1px solid var(--ctl-line);
    background: var(--ctl);
    color: var(--dim);
  }
  /* autodetect: grey while off (the default), terminal blue while on */
  .nld {
    color: #6c6e74;
    transition: color var(--fast);
  }
  .nld:hover {
    color: var(--dim);
  }
  .nld[aria-pressed='true'] {
    color: var(--on-blue);
  }
  /* model chip: sans text, one outlined box, thin divider, chevron only after the effort */
  .model-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    height: 22px;
    padding: 0 7px 0 5px;
    border-radius: 5px;
    border: 1px solid var(--ctl-line);
    background: var(--ctl);
    font: 400 12.5px/1 var(--sans);
    color: var(--dim);
    white-space: nowrap;
    overflow: hidden;
  }
  .mc-m {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .model-chip .sep {
    flex: none;
    width: 1px;
    height: 12px;
    background: var(--ctl-line);
  }
  .mc-e,
  .model-chip svg {
    flex: none;
  }
  .model-chip svg {
    margin-left: 4px;
    color: var(--dim);
  }

  .md-status {
    max-width: 880px;
    margin: 14px auto 0;
    min-height: 22px;
    font: 500 13.5px/1.5 var(--mono);
    color: var(--ash);
    text-align: center;
  }

  /* live states */
  .rv {
    animation: rv 0.42s var(--ease) both;
  }
  @keyframes rv {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }
  .is-hidden {
    visibility: hidden;
  }

  /* ================= the facts strip ================= */
  .md-facts {
    list-style: none;
    margin: clamp(48px, 6vw, 88px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
  }
  .md-facts li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 22px clamp(14px, 1.8vw, 26px) 6px;
    border-left: 1px solid var(--rule);
  }
  .md-facts li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .f-k {
    display: flex;
    gap: 6px;
    align-items: center;
    min-height: 28px;
  }
  .f-k kbd {
    font-size: 13px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .f-k kbd.is-hit {
    color: var(--gold);
    border-color: rgba(255, 178, 58, 0.6);
  }
  .f-nld {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 26px;
    border: 1px solid var(--bar);
    border-radius: 7px;
    color: var(--ash);
  }
  /* the model chip's look: sans text, one outlined box, a thin divider */
  .f-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 9px;
    border: 1px solid var(--bar);
    border-radius: 6px;
    font: 400 12.5px/1 var(--sans);
    color: var(--ash);
  }
  .f-chip i {
    width: 1px;
    height: 12px;
    background: var(--bar);
  }
  .f-v {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ash);
  }
  .f-v em {
    font: normal 500 13.5px/1.4 var(--mono);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    /* the giant halves wrap into noise at this width; the switch and the status line carry the mode */
    .md-words {
      display: none;
    }
    .md-app {
      padding: 4px 6px 6px;
    }
    .md-out {
      height: 250px;
      padding-inline: 6px;
    }
    .q,
    .a {
      font-size: 12.5px;
    }
    /* the agent footer is a full row at this width: tighter gaps leave the model name some room */
    .inp {
      padding-inline: 12px;
    }
    .inp-foot {
      gap: 6px;
    }
    .foot-r {
      gap: 4px;
    }
    .model-chip {
      gap: 5px;
      padding: 0 6px 0 5px;
      font-size: 11.5px;
    }
    .md-facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .md-facts li {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--rule);
    }
    .md-facts li:first-child {
      border-top: 0;
    }
  }

  /* the switch keeps the app's size, but gets a finger-sized hit area */
  [data-set] {
    position: relative;
  }
  [data-set]::after {
    content: '';
    position: absolute;
    inset: -9px -2px;
  }
</style>

<script>
  type Mode = 'terminal' | 'agent';

  const root = document.querySelector<HTMLElement>('[data-modes]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
    const stage = $('[data-stage]');
    const line = $('[data-line]');
    const ph = $('[data-ph]');
    const outT = $('[data-out-t]');
    const outA = $('[data-out-a]');
    const lines = [...root.querySelectorAll<HTMLElement>('[data-lines] > span')];
    const stream = $('[data-stream]');
    const acts = $('[data-acts]');
    const hints = $('[data-hints]');
    const ctxBtn = $('[data-ctx]');
    const agentOnly = [...root.querySelectorAll<HTMLElement>('[data-agent-only]')];
    const nld = $<HTMLButtonElement>('[data-nld]');
    const statusText = $('[data-status-text]');
    const setBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-set]')];
    const kbds = [...root.querySelectorAll<HTMLElement>('[data-kbd]')];

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    const KEY = isMac ? '⌘I' : 'Ctrl-I';
    kbds.forEach((k) => (k.textContent = KEY));
    setBtns.forEach((b) => (b.title = `${b.getAttribute('aria-label')} (${KEY})`));

    const TEXT = { terminal: 'git log --oneline -4', agent: 'What changed in 0.3.5?' };
    // agent placeholder: "Ask the agent" in a fresh pane, "Ask a follow up" once it has a conversation
    const PH = { terminal: 'Run a command', agent: 'Ask the agent', follow: 'Ask a follow up' };
    const STATUS = {
      terminal: 'Terminal mode. The line runs in your shell.',
      agent: 'Agent Mode. The line goes to your model.',
    };
    // the reply as text and inline-code runs, so it can stream word by word and keep its code tint
    const segs = [...stream.childNodes].map((n) => ({
      code: n.nodeName === 'CODE',
      words: (n.textContent ?? '').replace(/\s+/g, ' ').split(/(?<= )/),
    }));
    const fullReply = stream.innerHTML;
    let conv = false;
    const placeholder = (m: Mode) => (m === 'terminal' ? PH.terminal : conv ? PH.follow : PH.agent);
    const markConv = () => {
      conv = true;
      ctxBtn.hidden = false;
      if (mode === 'agent') ph.textContent = PH.follow;
    };

    let mode: Mode = 'terminal';
    let token = 0;
    let auto = !reduce;
    let inView = false;
    let seen = false;
    let wake: (() => void) | null = null;

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const alive = (t: number) => t === token;
    // no timers while off screen: the observer resolves this when the stage comes back
    const waitView = () => (inView ? Promise.resolve() : new Promise<void>((r) => (wake = r)));

    const reveal = (el: HTMLElement, delay = 0) => {
      el.classList.remove('rv', 'is-hidden');
      void el.offsetWidth;
      el.style.animationDelay = `${delay}ms`;
      el.classList.add('rv');
    };

    // show the finished output for a mode, with no typing (reduced motion / first paint)
    const finalFrame = (m: Mode) => {
      outT.hidden = m !== 'terminal';
      outA.hidden = m !== 'agent';
      stream.innerHTML = fullReply;
      [...lines, stream, acts, hints].forEach((el) => el.classList.remove('is-hidden'));
      line.textContent = '';
      if (m === 'agent') markConv();
    };

    // the output on screen stays complete while the next line is typed: the card is never empty
    const settle = () => {
      stream.innerHTML = fullReply;
      [outT, outA, ...lines, stream, acts, hints].forEach((el) => el.classList.remove('is-hidden'));
    };

    const run = async (m: Mode) => {
      const t = ++token;
      if (reduce) return finalFrame(m);
      settle();
      line.textContent = '';
      await sleep(260);
      for (const ch of TEXT[m]) {
        if (!alive(t)) return;
        line.textContent += ch;
        await sleep(32 + Math.random() * 46);
      }
      await sleep(520);
      if (!alive(t)) return;
      line.textContent = '';
      // submitted: swap in the new output and produce it
      outT.hidden = m !== 'terminal';
      outA.hidden = m !== 'agent';
      if (m === 'terminal') {
        lines.forEach((l) => l.classList.add('is-hidden'));
        reveal(outT);
        lines.forEach((l, i) => reveal(l, 120 + i * 70));
      } else {
        [stream, acts, hints].forEach((el) => el.classList.add('is-hidden'));
        stream.textContent = '';
        reveal(outA);
        await sleep(700);
        if (!alive(t)) return;
        stream.classList.remove('is-hidden');
        for (const seg of segs) {
          const node = seg.code ? stream.appendChild(document.createElement('code')) : stream.appendChild(document.createTextNode(''));
          for (const w of seg.words) {
            if (!alive(t)) return;
            node.textContent += w;
            await sleep(38 + Math.random() * 42);
          }
        }
        if (!alive(t)) return;
        reveal(acts);
        reveal(hints, 120);
        markConv();
      }
    };

    const setMode = (m: Mode, opts: { from?: 'user' | 'auto' } = {}) => {
      if (m === mode && opts.from !== 'auto') return;
      mode = m;
      stage.dataset.now = m;
      setBtns.forEach((b) => {
        const on = b.dataset.set === m;
        b.setAttribute('aria-pressed', String(on));
        if (on && !reduce) {
          b.classList.add('is-press');
          setTimeout(() => b.classList.remove('is-press'), 160);
        }
      });
      agentOnly.forEach((el) => (el.hidden = m !== 'agent'));
      ph.textContent = placeholder(m);
      statusText.textContent = STATUS[m];
      run(m);
    };

    const stopAuto = () => (auto = false);

    // the switch, and the giant halves as a big pointer target
    setBtns.forEach((b) =>
      b.addEventListener('click', () => {
        stopAuto();
        setMode(b.dataset.set as Mode, { from: 'user' });
      }),
    );
    root.querySelectorAll<HTMLElement>('[data-pick]').forEach((h) =>
      h.addEventListener('click', () => {
        stopAuto();
        setMode(h.dataset.pick as Mode, { from: 'user' });
      }),
    );
    nld.addEventListener('click', () => {
      stopAuto();
      const on = nld.getAttribute('aria-pressed') !== 'true';
      nld.setAttribute('aria-pressed', String(on));
      const label = on ? 'Disable terminal command autodetection' : 'Enable terminal command autodetection';
      nld.setAttribute('aria-label', label);
      nld.title = label;
      statusText.textContent = on
        ? 'Autodetection on: shell commands typed into agent input run in your shell.'
        : 'Autodetection off (the default): everything typed here goes to the agent.';
    });

    // ⌘I / Ctrl-I, only while the section is on screen and focus isn't in a text field elsewhere
    const editable = (el: Element | null) =>
      !!el && (el.matches('input, textarea, select, [contenteditable]:not([contenteditable="false"])') || (el as HTMLElement).isContentEditable);
    document.addEventListener('keydown', (e) => {
      if (!inView || e.altKey || e.defaultPrevented) return;
      if (editable(document.activeElement)) return;
      const k = e.key.toLowerCase();
      if (k === 'i' && (e.metaKey || e.ctrlKey) && !e.shiftKey) {
        e.preventDefault();
        stopAuto();
        kbds.forEach((kb) => {
          kb.classList.add('is-hit');
          setTimeout(() => kb.classList.remove('is-hit'), 220);
        });
        setMode(mode === 'terminal' ? 'agent' : 'terminal', { from: 'user' });
      }
    });

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        if (inView && wake) {
          wake();
          wake = null;
        }
        if (inView && !seen) {
          seen = true;
          if (!reduce) loop();
        }
      },
      { threshold: 0.45 },
    ).observe(stage);

    // gentle auto-flip until the visitor touches anything
    const loop = async () => {
      if (!auto) return; // the visitor got here first
      run(mode);
      await sleep(5200);
      while (auto) {
        await waitView();
        if (!auto) return;
        setMode(mode === 'terminal' ? 'agent' : 'terminal', { from: 'auto' });
        await sleep(mode === 'agent' ? 8200 : 5600);
      }
    };
    stage.addEventListener('pointerdown', stopAuto);
    stage.addEventListener('focusin', stopAuto);
  }
</script>
