</style>

<script>
  // Platform key swaps, and mark the section live so its CSS loops only run while visible.
  const section = document.getElementById('everything');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // shortcuts are written for macOS; elsewhere show the Linux/Windows binding (app/src/workspace/mod.rs, util/bindings.rs)
  if (section && !/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    section.querySelectorAll<HTMLElement>('[data-k-pc]').forEach((k) => {
      k.replaceChildren(
        ...k.dataset.kPc!.split(' ').map((t) => Object.assign(document.createElement('kbd'), { textContent: t })),
      );
    });
  }
  if (section && !reduce) section.classList.add('is-live');

</script>
