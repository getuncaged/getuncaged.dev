---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
---

<section class="cta" id="get" aria-labelledby="cta-h">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="cta-bars" aria-hidden="true">
    {Array.from({ length: 9 }).map((_, i) => <i style={`--i:${i}`}></i>)}
  </div>
  <div class="container cta-inner">
    <Logo idp="cta" size={72} class="cta-mark" />
    <h2 class="cta-h" id="cta-h">
      <span>Open the</span>
      <span>cage.</span>
    </h2>
    <p class="cta-triad">Your models. Your keys. Your machine.</p>
    <div class="cta-act">
      <button class="install-cmd" type="button" data-install-copy aria-label="Copy the install command">
        <code><span class="hi-prompt">❯</span><span data-install-cmd>curl -fsSL https://getuncaged.dev/install.sh | bash</span></code>
        <span class="hi-copy" data-copy-label>copy</span>
      </button>
      <div class="cta-btns">
        <a class="btn btn-primary" href="#install">All downloads</a>
        <a class="btn btn-ghost" href={SITE.github} rel="noopener">Star on GitHub</a>
      </div>
    </div>
    <p class="cta-fine">Free forever · AGPL-3.0 · v{SITE.version} · macOS, Linux, Windows</p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(120px, 14vw, 220px);
    border-top: 1px solid var(--rule-strong);
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    inset: auto -20% -60% -20%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(255, 122, 24, 0.26), rgba(255, 77, 28, 0.06) 55%, transparent 75%);
    animation: breathe 16s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    to {
      opacity: 0.6;
      transform: scale(1.06);
    }
  }
  /* the bars, pried apart around the headline */
  .cta-bars {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: flex;
    justify-content: center;
    gap: clamp(36px, 7vw, 120px);
    pointer-events: none;
  }
  .cta-bars i {
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--rule-strong) 30%, var(--rule-strong) 70%, transparent);
    transform: translateX(calc((var(--i) - 4) * clamp(10px, 2.6vw, 44px)));
  }
  .cta-bars i:nth-child(5) {
    opacity: 0;
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 28px;
  }
  .cta-mark {
    color: var(--ink);
    filter: drop-shadow(0 0 40px rgba(255, 122, 24, 0.35));
  }
  .cta-h {
    display: flex;
    flex-direction: column;
    font: 800 var(--fs-giga) / 0.88 var(--mono);
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .cta-h span:last-child {
    color: var(--ember);
    text-shadow: 0 0 80px rgba(255, 122, 24, 0.45);
  }
  .cta-triad {
    font: 700 clamp(16px, 1.6vw, 21px) / 1.3 var(--mono);
    letter-spacing: -0.02em;
    color: var(--ash);
  }
  .cta-act {
    display: grid;
    gap: 16px;
    justify-items: center;
    width: min(620px, 100%);
  }
  .cta-act .install-cmd {
    width: 100%;
  }
  .cta-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .cta-fine {
    font: 500 12.5px/1.4 var(--mono);
    color: var(--ash);
    letter-spacing: 0.04em;
  }
</style>
