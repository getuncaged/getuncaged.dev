<script>
  type Conn = { model: string; effort: string | null; usable: boolean; order: number; name?: string; endpoint?: string };
  type Pre = {
    id: string;
    label: string;
    group: string;
    wire: string;
    endpoint: string;
    model: string;
    needsKey: boolean;
    usableOnConnect: boolean;
    levels: string[];
  };

  const root = document.getElementById('models-rig');
  const dataEl = document.getElementById('models-data');
  if (root && dataEl) {
    const data = JSON.parse(dataEl.textContent || '{}') as {
      presets: Pre[];
      effort: { v: string; l: string }[];
      seed: { active: string; conns: Record<string, Conn> };
    };
    const P: Record<string, Pre> = Object.fromEntries(data.presets.map((p) => [p.id, p]));
    const effLabel = (v: string | null) => data.effort.find((e) => e.v === v)?.l ?? 'Default';
    const kind = (w: string) => (w === 'cli' ? 'acp' : w);
    const clone = <T,>(o: T): T => JSON.parse(JSON.stringify(o));
    // A connection keeps its own name and base URL; a fresh one takes the preset's.
    const nameOf = (id: string) => conns[id]?.name ?? P[id].label;
    const endOf = (id: string) => conns[id]?.endpoint ?? P[id].endpoint;

    let active = data.seed.active;
    let conns: Record<string, Conn> = clone(data.seed.conns);
    let nextOrder = 3;

    const $ = (sel: string, el: ParentNode = root) => el.querySelector<HTMLElement>(sel);
    const $$ = (sel: string, el: ParentNode = root) => [...el.querySelectorAll<HTMLElement>(sel)];
    const lanes = $$('#models [data-lane]', document);
    const toastEl = $('[data-toast]');
    const logEl = $('[data-log]');
    const tpl = root.querySelector<HTMLTemplateElement>('template[data-log-tpl]');
    let toastT = 0;

    const toast = (msg: string) => {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.add('is-on');
      clearTimeout(toastT);
      toastT = window.setTimeout(() => toastEl.classList.remove('is-on'), 2600);
    };
    const log = (k: string, v: string) => {
      if (!logEl || !tpl) return;
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector('.lk')!.textContent = k;
      li.querySelector('.lv')!.textContent = v;
      li.classList.add('is-new');
      logEl.append(li);
      while (logEl.children.length > 7) logEl.firstElementChild!.remove();
    };
    const writes = () => {
      const p = P[active];
      log('write', 'connections.json');
      log('write', `engine.json · ${kind(p.wire)} · ${conns[active].model || nameOf(active)}`);
    };
    const flashChip = () => {
      const chip = $('[data-chip]');
      if (!chip) return;
      chip.classList.remove('is-flash');
      void chip.offsetWidth;
      chip.classList.add('is-flash');
    };

    const render = () => {
      const ap = P[active];
      const ac = conns[active];
      for (const p of data.presets) {
        const c = conns[p.id];
        const on = p.id === active;
        // Connected roster row
        const row = $(`[data-conn="${p.id}"]`);
        if (row) {
          row.hidden = !c;
          if (c) row.style.order = String(c.order);
          row.classList.toggle('is-active', on);
          $('[data-pill-active]', row)!.hidden = !on;
          const st = $('[data-status]', row)!;
          st.textContent = c?.usable ? 'Ready' : p.needsKey ? 'Needs key' : 'Incomplete';
          st.className = `pill ${c?.usable ? 'pill-ok' : 'pill-warn'}`;
          $('[data-use]', row)!.hidden = !c || on || !c.usable;
          const model = c?.model ?? p.model;
          const ep = endOf(p.id);
          $('[data-name]', row)!.textContent = nameOf(p.id);
          $('[data-sub]', row)!.textContent = model ? `${model} · ${ep}` : ep;
        }
        // Gallery card
        const card = $(`[data-card="${p.id}"]`);
        if (card) {
          card.classList.toggle('is-active', on);
          $('[data-inuse]', card)!.hidden = !on;
          $('[data-connected]', card)!.hidden = !c || on;
          $('[data-connect]', card)!.hidden = !!c;
        }
        // Model menu row + its model list
        const mrow = $(`[data-mrow="${p.id}"]`);
        if (mrow) {
          mrow.hidden = !c;
          if (c) mrow.style.order = String(c.order);
          const btn = $('[data-pick-conn]', mrow)!;
          btn.setAttribute('aria-pressed', String(on));
          (btn as HTMLButtonElement).disabled = !c?.usable;
          const model = c?.model ?? p.model;
          $('[data-mlabel]', mrow)!.textContent = `${nameOf(p.id)} · ${model || 'no model'}`;
          const sub = $('[data-msub]', mrow);
          if (sub) {
            const items = $$('[data-pick-model]', sub);
            const show = items.length > 1 || (items.length === 1 && items[0].dataset.pickModel !== model);
            sub.hidden = !on || !show;
            items.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pickModel === model)));
          }
        }
      }
      // Effort menu
      const lv = ap.levels;
      $('[data-effort-list]')!.hidden = lv.length === 0;
      $('[data-effort-none]')!.hidden = lv.length > 0;
      $$('[data-eff-row]').forEach((li) => {
        const v = li.dataset.effRow!;
        li.hidden = v !== '' && !lv.includes(v);
        li.querySelector('button')!.setAttribute('aria-pressed', String((ac.effort ?? '') === v));
      });
      // Chip: model id (or the label when none), a drawn rule, "{Level} effort"
      $('[data-chip-model]')!.textContent = ac.model || nameOf(active);
      $('[data-chip-rule]')!.hidden = lv.length === 0;
      $('[data-chip-eff]')!.hidden = lv.length === 0;
      $('[data-chip-eff-t]')!.textContent = `${effLabel(ac.effort)} effort`;
      // Lanes
      lanes.forEach((l) => l.classList.toggle('is-live', l.dataset.lane === ap.group));
      document.dispatchEvent(
        new CustomEvent('uncaged:active', {
          detail: { group: ap.group, wire: ap.wire, label: nameOf(active), endpoint: endOf(active) },
        })
      );
    };

    // Settings "Use" toasts "Now using {label}." (ai_page.rs:2375); the model
    // menu toasts "Switched to {model or label}" (profile_model_selector.rs:2512).
    const use = (id: string, from: 'settings' | 'menu') => {
      if (!conns[id]?.usable || id === active) return;
      active = id;
      render();
      flashChip();
      toast(from === 'menu' ? `Switched to ${conns[id].model || nameOf(id)}` : `Now using ${nameOf(id)}.`);
      writes();
      if (P[id].wire === 'cli') log('note', 'ACP: text-only, the CLI runs its own tools');
    };

    root.addEventListener('click', (ev) => {
      const t = (ev.target as HTMLElement).closest<HTMLElement>('button');
      if (!t) return;
      const d = t.dataset;
      if ('nld' in d) {
        // The autodetect toggle: grey off, terminal-blue on (off by default).
        const on = t.getAttribute('aria-pressed') !== 'true';
        const label = `${on ? 'Disable' : 'Enable'} terminal command autodetection`;
        t.setAttribute('aria-pressed', String(on));
        t.setAttribute('aria-label', label);
        t.title = label;
      } else if (d.use) use(d.use, 'settings');
      else if (d.pickConn) use(d.pickConn, 'menu');
      else if (d.edit) log('opens', `Connect ${nameOf(d.edit)}`);
      else if (d.connect) {
        const p = P[d.connect];
        if (conns[p.id]) return;
        conns[p.id] = { model: p.model, effort: null, usable: p.usableOnConnect, order: nextOrder++ };
        const row = $(`[data-conn="${p.id}"]`);
        row?.classList.add('is-new');
        if (p.usableOnConnect) {
          active = p.id;
          render();
          flashChip();
          toast(`Connected ${p.label} — ready to use.`);
          writes();
          if (p.wire === 'cli') log('note', 'ACP: text-only, the CLI runs its own tools');
        } else {
          render();
          log('opens', `Connect ${p.label} · ${p.needsKey ? 'API key' : 'base URL'}`);
        }
        // Keep the new roster row in view inside the settings page.
        row?.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      } else if (d.pickModel !== undefined) {
        const c = conns[active];
        if (!c || d.for !== active || c.model === d.pickModel) return;
        c.model = d.pickModel;
        render();
        flashChip();
        toast(`Model set to ${c.model}`);
        writes();
        if (active === 'claude-code') log('ACP', 'session/set_model · live session');
      } else if (d.pickEffort !== undefined) {
        const c = conns[active];
        const v = d.pickEffort || null;
        if (!c || c.effort === v) return;
        c.effort = v;
        render();
        flashChip();
        toast(`Effort set to ${effLabel(v)}`);
        writes();
        if (active === 'claude-code') log('ACP', 'session reopened with resume · context kept');
      } else if ('reset' in d) {
        active = data.seed.active;
        conns = clone(data.seed.conns);
        nextOrder = 3;
        render();
        log('reset', '3 connections · Claude Code active');
      }
    });
  }
</script>
