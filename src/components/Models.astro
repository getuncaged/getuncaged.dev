---
import AppIcon from './AppIcon.astro';
import SettingsWindow from './SettingsWindow.astro';

/**
 * 03 · any model. Three ways to power Agent Mode, then a working recreation of
 * Settings → Agents → Models → "Connect a model" as in the current app.
 *
 * Every app string here is verbatim from tag v0.3.3:
 *   groups, subtitles, preset labels, blurbs, models  crates/uncaged_engine/src/catalog.rs
 *   "Connect a model", "Connected", Active/Local/In use  app/src/settings_view/ai_page.rs (uncaged-0.3)
 *   "AI features" card                                  ai_page.rs:5010-5014
 *   Connect / Use / Edit, toasts                        ai_page.rs:2308-2375
 *   Ready / Needs key / Incomplete                      crates/uncaged_engine/src/connections.rs:114-122
 *   chip, model menu, effort menu, toasts               app/src/terminal/profile_model_selector.rs:255-520, 2540-2575
 *   effort levels per wire                              crates/uncaged_engine/src/config.rs:56-71
 * The window's layout, colours and the seeded roster are those of the capture
 * shots-in/v2/models.png (lmstudio, Claude Code active on opus[1m], Ollama).
 * The first paint is that complete state; the script only lets the visitor
 * change it.
 */

type GroupKey = 'agent' | 'local' | 'api';
type Preset = {
  id: string;
  label: string;
  blurb: string;
  group: GroupKey;
  wire: 'cli' | 'anthropic' | 'openai_compatible';
  endpoint: string;
  model: string;
  models: string[];
  needsKey: boolean;
  usableOnConnect: boolean;
  local: boolean;
  /** the app's provider logo (AppIcon name) */
  icon: string;
};

const EFFORT = [
  { v: 'low', l: 'Low' },
  { v: 'medium', l: 'Medium' },
  { v: 'high', l: 'High' },
  { v: 'xhigh', l: 'Extra high' },
  { v: 'max', l: 'Max' },
];
const levelsFor = (p: Preset) =>
  p.wire === 'anthropic'
    ? ['low', 'medium', 'high', 'xhigh', 'max']
    : p.wire === 'cli'
      ? p.id === 'claude-code'
        ? ['low', 'medium', 'high', 'max']
        : []
      : ['low', 'medium', 'high'];

const P = (p: Omit<Preset, 'usableOnConnect' | 'local'> & { local?: boolean; usableOnConnect?: boolean }): Preset => ({
  local: p.group !== 'api',
  usableOnConnect: !p.needsKey && p.id !== 'custom',
  ...p,
});

// catalog.rs order. Ollama / LM Studio ship no model list (catalog.rs `models: &[]`);
// the app fills it from GET {base}/models at run time, so none is shown here.
const PRESETS: Preset[] = [
  P({ id: 'claude-code', label: 'Claude Code', icon: 'claude', group: 'agent', wire: 'cli', endpoint: 'claude-code-acp', model: 'sonnet', models: ['default', 'sonnet', 'haiku', 'opus[1m]'], needsKey: false, blurb: 'Drive your installed `claude` CLI with its own login — no API key.' }),
  P({ id: 'gemini-cli', label: 'Gemini CLI', icon: 'gemini_cli', group: 'agent', wire: 'cli', endpoint: 'gemini --experimental-acp', model: 'gemini-2.5-pro', models: ['gemini-2.5-pro', 'gemini-2.5-flash'], needsKey: false, blurb: 'Drive your installed `gemini` CLI with its Google login — no API key.' }),
  P({ id: 'codex', label: 'Codex CLI', icon: 'openai', group: 'agent', wire: 'cli', endpoint: 'codex acp', model: '', models: [], needsKey: false, blurb: 'Drive your installed `codex` CLI with its ChatGPT/OpenAI login — no API key.' }),
  P({ id: 'ollama', label: 'Ollama (local)', icon: 'ollama', group: 'local', wire: 'openai_compatible', endpoint: 'localhost:11434', model: 'qwen2.5-coder', models: [], needsKey: false, blurb: 'Run open models on your own machine — fully private, no key.' }),
  P({ id: 'lmstudio', label: 'LM Studio (local)', icon: 'lm-studio', group: 'local', wire: 'openai_compatible', endpoint: 'localhost:1234', model: 'local-model', models: [], needsKey: false, blurb: "Local models via LM Studio's server — private, no key." }),
  P({ id: 'anthropic', label: 'Anthropic (Claude)', icon: 'claude', group: 'api', wire: 'anthropic', endpoint: 'api.anthropic.com', model: 'claude-sonnet-4-5', models: ['claude-opus-4-8', 'claude-sonnet-4-5', 'claude-haiku-4-5'], needsKey: true, blurb: 'Claude Opus, Sonnet & Haiku — strongest for code & agentic work.' }),
  P({ id: 'openai', label: 'OpenAI', icon: 'openai', group: 'api', wire: 'openai_compatible', endpoint: 'api.openai.com', model: 'gpt-4o', models: ['gpt-4o', 'gpt-4o-mini', 'o3-mini'], needsKey: true, blurb: 'GPT-4o / o-series via the OpenAI API.' }),
  P({ id: 'openrouter', label: 'OpenRouter', icon: 'openrouter', group: 'api', wire: 'openai_compatible', endpoint: 'openrouter.ai', model: 'anthropic/claude-sonnet-4-5', models: ['anthropic/claude-sonnet-4-5', 'anthropic/claude-opus-4-1', 'openai/gpt-4o', 'google/gemini-2.5-pro'], needsKey: true, blurb: 'One key, hundreds of models (Claude, GPT, Llama, Gemini, …).' }),
  P({ id: 'google', label: 'Google Gemini', icon: 'gemini_cli', group: 'api', wire: 'openai_compatible', endpoint: 'generativelanguage.googleapis.com', model: 'gemini-2.5-pro', models: ['gemini-2.5-pro', 'gemini-2.5-flash'], needsKey: true, blurb: 'Gemini 2.5 Pro & Flash via the OpenAI-compatible endpoint.' }),
  P({ id: 'groq', label: 'Groq', icon: 'groq', group: 'api', wire: 'openai_compatible', endpoint: 'api.groq.com', model: 'llama-3.3-70b-versatile', models: ['llama-3.3-70b-versatile', 'llama-3.1-8b-instant'], needsKey: true, blurb: 'Open models at very low latency.' }),
  P({ id: 'deepseek', label: 'DeepSeek', icon: 'deepseek', group: 'api', wire: 'openai_compatible', endpoint: 'api.deepseek.com', model: 'deepseek-chat', models: ['deepseek-chat', 'deepseek-reasoner'], needsKey: true, blurb: 'DeepSeek-V3 chat & R1 reasoning.' }),
  P({ id: 'mistral', label: 'Mistral', icon: 'mistral', group: 'api', wire: 'openai_compatible', endpoint: 'api.mistral.ai', model: 'mistral-large-latest', models: ['mistral-large-latest', 'codestral-latest'], needsKey: true, blurb: 'Mistral & Codestral models.' }),
  P({ id: 'xai', label: 'xAI (Grok)', icon: 'x-logo', group: 'api', wire: 'openai_compatible', endpoint: 'api.x.ai', model: 'grok-3', models: ['grok-3', 'grok-3-mini'], needsKey: true, blurb: 'Grok models from xAI.' }),
  P({ id: 'together', label: 'Together AI', icon: 'together', group: 'api', wire: 'openai_compatible', endpoint: 'api.together.xyz', model: 'meta-llama/Llama-3.3-70B-Instruct-Turbo', models: ['meta-llama/Llama-3.3-70B-Instruct-Turbo', 'Qwen/Qwen2.5-Coder-32B-Instruct'], needsKey: true, blurb: 'A broad catalog of open models.' }),
  P({ id: 'custom', label: 'Custom (OpenAI-compatible)', icon: 'sliders-04', group: 'api', wire: 'openai_compatible', endpoint: 'no endpoint', model: '', models: [], needsKey: false, local: false, blurb: 'Any server that speaks /chat/completions.' }),
];

const GROUPS: { key: GroupKey; title: string; subtitle: string }[] = [
  { key: 'agent', title: 'Use a local agent', subtitle: "Drive a CLI you've already signed in to — no API key, your own subscription." },
  { key: 'local', title: 'Run a model locally', subtitle: 'Open models on your own machine — fully private, no key.' },
  { key: 'api', title: 'Connect with an API key', subtitle: 'Bring your own key from a cloud provider.' },
];

// The seeded roster is the capture's: an LM Studio connection the user named
// "lmstudio" (pointed at 127.0.0.1), Claude Code active on opus[1m] at Medium
// effort (the chip reads "opus[1m] | Medium effort"), and Ollama on its default.
type Conn = { model: string; effort: string | null; usable: boolean; order: number; name?: string; endpoint?: string };
const SEED = {
  active: 'claude-code',
  conns: {
    lmstudio: { name: 'lmstudio', endpoint: '127.0.0.1:1234', model: 'qwen3-coder-30b-a3b-instruct-mlx', effort: null, usable: true, order: 0 },
    'claude-code': { model: 'opus[1m]', effort: 'medium', usable: true, order: 1 },
    ollama: { model: 'qwen2.5-coder', effort: null, usable: true, order: 2 },
  } as Record<string, Conn>,
};

const byId = Object.fromEntries(PRESETS.map((p) => [p.id, p]));
const seedActive = byId[SEED.active];
const seedConn = SEED.conns[SEED.active];
const effortLabel = (v: string | null) => EFFORT.find((e) => e.v === v)?.l ?? 'Default';
const nameOf = (p: Preset, c?: Conn) => c?.name ?? p.label;
const endOf = (p: Preset, c?: Conn) => c?.endpoint ?? p.endpoint;
const showModels = (p: Preset, model: string) => p.models.length > 1 || (p.models.length === 1 && p.models[0] !== model);

const client = {
  presets: PRESETS.map(({ id, label, group, wire, endpoint, model, needsKey, usableOnConnect }) => ({
    id, label, group, wire, endpoint, model, needsKey, usableOnConnect, levels: levelsFor(byId[id]),
  })),
  effort: EFFORT,
  seed: SEED,
};

// Lane copy stays short: the rig below shows effort levels, the presets and
// the ACP session behaviour, so the lanes carry only what the rig can't.
const lanes = [
  {
    n: '1',
    key: 'local',
    title: 'Run a model locally',
    pill: 'On-device',
    names: ['Ollama', 'LM Studio', 'llama.cpp', 'vLLM'],
    logos: ['ollama', 'lm-studio'],
    body: 'No key, no bill. Ollama and LM Studio connect in one click, any other OpenAI-compatible server goes in as Custom, and the model menu lists what your server returns from <code>GET /models</code>.',
    proof: ['recommended', 'Qwen3-Coder-30B-A3B (MLX 4-bit)'],
  },
  {
    n: '2',
    key: 'agent',
    title: 'Use a local agent',
    pill: 'Your login',
    names: ['Claude Code', 'Codex CLI', 'Gemini CLI'],
    logos: ['claude', 'openai', 'gemini_cli'],
    body: 'Drives the CLI you already pay for over ACP, signed in with its own login. Text-only for now: the CLI runs its own tool loop, so Uncaged’s approval cards are bypassed. It starts in your terminal’s folder and gets Uncaged’s local code search as a tool.',
    proof: ['spawns', 'claude-code-acp · codex acp · gemini --experimental-acp'],
  },
  {
    n: '3',
    key: 'api',
    title: 'Connect with an API key',
    pill: 'API key',
    names: ['Anthropic', 'OpenAI', 'Google', 'Mistral', 'DeepSeek', 'Groq', 'Together', 'xAI', 'OpenRouter', 'any OpenAI-compatible endpoint'],
    logos: ['claude', 'openai', 'gemini_cli', 'mistral', 'deepseek', 'groq', 'together', 'x-logo', 'openrouter'],
    body: 'Paste a key and press Use; the key is stored in plain text on this machine. Anthropic goes over its Messages API, everything else over <code>/chat/completions</code>, so any server that speaks it works as Custom.',
    proof: ['default', 'claude-sonnet-4-5 · api.anthropic.com'],
  },
];

---

<section class="section models" id="models" aria-labelledby="models-h">
  <div class="container">
    <span class="sec-tag"><b>03</b> any model</span>

    <header class="m-head">
      <p class="eyebrow">Settings → Agents → Models</p>
      <h2 class="h2" id="models-h">Your GPU, your login<span class="dim">,</span><br /><span class="dim">or your key</span><span class="ember">.</span></h2>
      <p class="lede">
        Agent Mode runs on whatever you connect: <strong>a model on your machine, the CLI agent you already pay
        for, or an API key.</strong> Keep several connected and switch with <b class="kw">Use</b>. Nothing goes to
        Uncaged.
      </p>
    </header>

    <!-- ============ the three lanes ============ -->
    <ol class="lanes" aria-label="The three ways to power Agent Mode">
      {
        lanes.map((l) => (
          <li class={`lane${l.key === seedActive.group ? ' is-live' : ''}`} data-lane={l.key}>
            <div class="lane-top">
              <span class="lane-n" aria-hidden="true">{l.n}</span>
              <span class="lane-live" aria-hidden="true">powering Agent Mode</span>
            </div>
            <h3 class="lane-t">
              {l.title} <span class="lane-pill">{l.pill}</span>
            </h3>
            <p class="lane-names">
              <span class="lane-logos" aria-hidden="true">
                {l.logos.map((n) => (
                  <AppIcon name={n} size={15} />
                ))}
              </span>
              {l.names.join(' · ')}
            </p>
            <p class="lane-body" set:html={l.body} />
            <p class="lane-proof">
              <span>{l.proof[0]}</span>
              <code tabindex="0" role="group" aria-label={`${l.proof[0]}: ${l.proof[1]}`}>{l.proof[1]}</code>
            </p>
          </li>
        ))
      }
    </ol>

    <!-- ============ the working recreation ============ -->
    <div class="rig" id="models-rig">
      <p class="rig-cap">
        <span class="rig-cap-k">try it</span>
        Press <b class="kw">Use</b> or <b class="kw">Connect</b>, pick a model, step the effort. Every label in the
        window and the menus is the app’s own.
      </p>

      <div class="rig-grid">
        <!-- Settings → Models, as in shots-in/v2/models.png -->
        <SettingsWindow page="Models" label="Models settings page, scrollable" class="st">
          <p class="sw-title">Models</p>
          <div class="sw-card st-ai">
            <span class="st-ai-t">
              <span class="st-ct">AI features</span>
              <span class="st-cd">Turn off to disable every AI feature, from agents to suggestions.</span>
            </span>
            <span class="sw-ai" aria-hidden="true" title="AI on"><i></i></span>
          </div>
          <div class="sw-card">
          <p class="st-sub">Connect a model</p>
          <p class="st-blurb">
            Power Agent Mode with your own model — a local agent CLI you're already signed in to, a private on-device
            model (Ollama / LM Studio), or any API key. Nothing goes to Uncaged; your keys stay on this machine.
          </p>

          <span class="st-label">Connected</span>
          <ul class="st-conns" aria-label="Connected">
            {
              PRESETS.map((p) => {
                const c = SEED.conns[p.id];
                const isActive = SEED.active === p.id;
                const model = c?.model ?? p.model;
                const ep = endOf(p, c);
                return (
                  <li
                    class={`card conn${isActive ? ' is-active' : ''}`}
                    data-conn={p.id}
                    hidden={!c}
                    style={c ? `order:${c.order}` : undefined}
                  >
                    <span class="ico" aria-hidden="true"><AppIcon name={p.icon} size={18} /></span>
                    <span class="c-text">
                      <span class="c-name">
                        <b data-name>{nameOf(p, c)}</b>
                        <span class="pill pill-accent" data-pill-active hidden={!isActive}>Active</span>
                        {p.local && <span class="pill pill-quiet">Local</span>}
                      </span>
                      <span class="c-sub" data-sub>{model ? `${model} · ${ep}` : ep}</span>
                    </span>
                    <span class="c-right">
                      <span class={`pill ${c ? 'pill-ok' : 'pill-warn'}`} data-status>
                        {c ? 'Ready' : p.needsKey ? 'Needs key' : 'Incomplete'}
                      </span>
                      <button class="abtn" type="button" data-use={p.id} hidden={!c || isActive}>
                        Use<span class="sr-only"> {nameOf(p, c)}</span>
                      </button>
                      <button class="abtn" type="button" data-edit={p.id}>
                        <AppIcon name="pencil-02" size={13} />
                        Edit<span class="sr-only"> {nameOf(p, c)}</span>
                      </button>
                    </span>
                  </li>
                );
              })
            }
          </ul>


          {
            GROUPS.map((g) => (
              <div class="st-group">
                <span class="st-label">{g.title}</span>
                <span class="st-gsub">{g.subtitle}</span>
                <ul class="st-cards" aria-label={g.title}>
                  {PRESETS.filter((p) => p.group === g.key).map((p) => {
                    const isActive = SEED.active === p.id;
                    const isConn = !!SEED.conns[p.id];
                    return (
                      <li class={`card gcard${isActive ? ' is-active' : ''}`} data-card={p.id}>
                        <span class="ico" aria-hidden="true"><AppIcon name={p.icon} size={18} /></span>
                        <span class="c-text">
                          <span class="c-name">
                            <b>{p.label}</b>
                          </span>
                          <span class="c-sub">{p.blurb}</span>
                        </span>
                        <span class="c-right">
                          <span class="pill pill-accent" data-inuse hidden={!isActive}>In use</span>
                          <span class="pill pill-ok" data-connected hidden={!isConn || isActive}>Connected</span>
                          <button class="abtn" type="button" data-connect={p.id} hidden={isConn}>
                            <AppIcon name="plus" size={13} />
                            Connect<span class="sr-only"> {p.label}</span>
                          </button>
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
          </div>
          <div class="toast" data-toast role="status" aria-live="polite" slot="after"></div>
        </SettingsWindow>

        <!-- Agent input, exploded: model menu + effort menu above the chip -->
        <div class="dock">
          <div class="menu" role="group" aria-label="Model menu">
            <span class="menu-k" aria-hidden="true">model menu</span>
            <ul class="menu-list">
              {
                PRESETS.map((p) => {
                  const c = SEED.conns[p.id];
                  const isActive = SEED.active === p.id;
                  const model = c?.model ?? p.model;
                  return (
                    <li data-mrow={p.id} hidden={!c} style={c ? `order:${c.order}` : undefined}>
                      <button
                        type="button"
                        class="mi"
                        data-pick-conn={p.id}
                        aria-pressed={isActive ? 'true' : 'false'}
                        disabled={c ? !c.usable : !p.usableOnConnect}
                      >
                        <span data-mlabel>
                          {nameOf(p, c)} · {model || 'no model'}
                        </span>
                        <i class="chk" aria-hidden="true"><AppIcon name="check" size={13} /></i>
                      </button>
                      <ul class="msub" data-msub={p.id} hidden={!isActive || !showModels(p, model)}>
                        <li class="mh" aria-hidden="true">Model</li>
                        {p.models.map((m) => (
                          <li>
                            <button
                              type="button"
                              class="mi mi-sub"
                              data-pick-model={m}
                              data-for={p.id}
                              aria-pressed={m === model ? 'true' : 'false'}
                            >
                              <span>{m}</span>
                              <i class="chk" aria-hidden="true"><AppIcon name="check" size={13} /></i>
                            </button>
                          </li>
                        ))}
                      </ul>
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <div class="menu" role="group" aria-label="Effort menu">
            <span class="menu-k" aria-hidden="true">effort menu</span>
            <ul class="menu-list" data-effort-list hidden={levelsFor(seedActive).length === 0}>
              {
                [{ v: '', l: 'Default' }, ...EFFORT].map((e) => {
                  const lv = levelsFor(seedActive);
                  const on = (seedConn.effort ?? '') === e.v;
                  return (
                    <li data-eff-row={e.v} hidden={e.v !== '' && !lv.includes(e.v)}>
                      <button type="button" class="mi" data-pick-effort={e.v} aria-pressed={on ? 'true' : 'false'}>
                        <span>{e.l}</span>
                        <i class="chk" aria-hidden="true"><AppIcon name="check" size={13} /></i>
                      </button>
                    </li>
                  );
                })
              }
            </ul>
            <p class="menu-none" data-effort-none hidden={levelsFor(seedActive).length > 0}>
              This agent takes no effort setting, so the chip shows the model only.
            </p>
          </div>

          <!-- the agent input card, as in shots-in/split-3-z.png (focused agent pane) -->
          <div class="inp">
            <div class="inp-chips" aria-hidden="true">
              <span class="ic"><AppIcon name="folder" size={13} />/tmp/uncaged</span>
              <span class="ic"><AppIcon name="git-branch-02" size={13} />main</span>
            </div>
            <div class="inp-line" aria-hidden="true">Ask a follow up</div>
            <div class="inp-foot">
              <span class="mode" aria-hidden="true">
                <i class="m-t" title="Terminal (⌘I)"><AppIcon name="terminal" size={13} /></i>
                <i class="m-a is-on" title="Agent Mode (⌘I)"><AppIcon name="sparkle" size={14} /></i>
              </span>
              <button
                type="button"
                class="ib nld"
                data-nld
                aria-pressed="false"
                aria-label="Enable terminal command autodetection"
                title="Enable terminal command autodetection"
              >
                <AppIcon name="nld" size={15} />
              </button>
              <span class="foot-r">
                <span class="ib" aria-hidden="true" title="Context window usage"><AppIcon name="conversation-context-0" size={15} /></span>
                <span class="chip-m" title="Choose an agent model" data-chip>
                  <span class="chip-model" data-chip-model>{seedConn.model || seedActive.label}</span>
                  <span class="chip-rule" data-chip-rule hidden={levelsFor(seedActive).length === 0} aria-hidden="true"></span>
                  <span class="chip-eff" data-chip-eff hidden={levelsFor(seedActive).length === 0}>
                    <span data-chip-eff-t>{effortLabel(seedConn.effort)} effort</span>
                    <AppIcon name="chevron-down" size={12} />
                  </span>
                </span>
                <span class="ib" aria-hidden="true" title="Attach file"><AppIcon name="plus" size={15} /></span>
              </span>
            </div>
          </div>

          <div class="log" role="group" aria-label="What the app wrote">
            <div class="log-h">
              <span>~/.uncaged</span>
              <button type="button" class="log-reset" data-reset>reset</button>
            </div>
            <ol class="log-lines" data-log>
              <li><span class="lk">read</span><span class="lv">connections.json · 3 connections</span></li>
              <li><span class="lk">active</span><span class="lv">Claude Code → engine.json · acp · opus[1m]</span></li>
            </ol>
            <template data-log-tpl><li><span class="lk"></span><span class="lv"></span></li></template>
          </div>
        </div>
      </div>

      <p class="rig-foot">
        Saved in <code>~/.uncaged/connections.json</code>, keys included, as plain JSON on your machine. The active
        connection is copied into <code>~/.uncaged/engine.json</code>, which the engine reads.
      </p>
    </div>
  </div>
</section>

<script type="application/json" id="models-data" set:html={JSON.stringify(client)} />

<style>
  .m-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 22px clamp(16px, 2vw, 32px);
    margin-bottom: clamp(48px, 6vw, 88px);
    padding-top: 30px;
  }
  .m-head .eyebrow {
    grid-column: 1 / -1;
  }
  .m-head .h2 {
    grid-column: 1 / span 7;
  }
  .m-head .lede {
    grid-column: 8 / -1;
    align-self: end;
  }
  .kw {
    font: 700 0.86em/1 var(--mono);
    color: var(--ink);
    padding: 2px 6px;
    border: 1px solid var(--bar);
    border-radius: 5px;
    white-space: nowrap;
  }

  /* ------------------------------------------------ lanes */
  .lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }
  .lane {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 0 clamp(16px, 2vw, 32px) clamp(24px, 3vw, 36px);
