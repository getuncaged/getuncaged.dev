  /* ---------------------------------------------- the theme preview
     render_preview (theme.rs:665) at the card's 1.2 scale: 190x100 → 228x120,
     8px mono → 9.6, margins 10 → 12, the theme background at
     (100 - image opacity)% over the image, an outline rule (the theme's text
     at ~10%) and a 2px accent cursor at the bottom left. */
  .tp {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 190 / 100;
    overflow: hidden;
    border-radius: 6px;
    padding: 12px 0;
    font: 400 9.6px/1.25 var(--mono);
    color: var(--t-fg);
    isolation: isolate;
    text-align: left;
    container-type: inline-size;
  }
  .tp::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--t-bg);
    opacity: var(--t-ov);
  }
  .tp-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tp-img[hidden] {
    display: none;
  }
  .tp-l1,
  .tp-l2 {
    padding: 0 12px;
    white-space: pre;
  }
  .tp-l2 {
    padding-top: 6px;
  }
  /* narrow cards shrink the type so the line still fits, as the app's fixed
     228px preview would */
  .tx-card .tp-l1,
  .tx-card .tp-l2 {
    font-size: min(9.6px, 5cqw);
  }
  .tp i {
    font-style: normal;
  }
  .tp .b {
    color: var(--t-bl);
  }
  .tp .r {
    color: var(--t-rd);
  }
  .tp-in {
    margin-top: auto;
    padding-top: 6px;
    border-top: 1.2px solid color-mix(in srgb, var(--t-fg) 10%, transparent);
  }
  .tp-cur {
    display: block;
    width: 2.4px;
    height: 14.4px;
    margin-left: 12px;
    background: var(--t-ac);
  }

  /* ---------------------------------------------- mini window */
  .mini {
    margin: 22px 0 0;
  }
  .mini-win {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--bar);
    background: #17191f;
    box-shadow: 0 30px 70px -36px rgba(0, 0, 0, 0.95);
  }
  .mini-bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
  }
  .mini-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #55575d;
  }
  .mini-tp {
