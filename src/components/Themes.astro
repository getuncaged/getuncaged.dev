</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-th]')) {
    const picks = [...root.querySelectorAll<HTMLElement>('[data-pick]')];
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    const show = (id: string) => {
      for (const p of picks) {
        const on = p.dataset.pick === id;
        p.classList.toggle('is-on', on);
        p.querySelector('button')?.setAttribute('aria-pressed', String(on));
      }
      for (const s of shots) s.classList.toggle('is-on', s.dataset.shot === id);
    };
    show(picks[0].dataset.pick!);
    root.classList.add('is-js');

    // Explore themes: search + filters (theme_explorer_body.rs), and Use.
    const items = [...root.querySelectorAll<HTMLElement>('[data-grid] > li')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const q = root.querySelector<HTMLInputElement>('[data-q]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    let filter = 'All';
    const EMPTY: Record<string, string> = {
      Available:
        'You already have every theme in the community gallery. Make one in Theme creator and share it with the community.',
      Downloaded: 'Nothing downloaded yet. Themes you get from the community gallery show up here.',
      Yours: "You haven't made a theme yet. Theme creator is where to start.",
    };
    const accepts = (origin: string) =>
      filter === 'All' || (filter === 'System' && origin === 'System') || (filter === 'Yours' && origin === 'Yours');
    const apply = () => {
      const query = (q?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        const ok = accepts(li.dataset.origin!) && (!query || li.dataset.name!.includes(query));
        li.hidden = !ok;
        if (ok) shown++;
      }
      if (empty) {
        empty.hidden = shown > 0;
        // an empty tab with no search says what the tab is for (theme_explorer_body.rs, uncaged-0.3)
        empty.textContent = query ? 'No themes match that search.' : EMPTY[filter] ?? 'No themes to show.';
      }
    };
    for (const f of filters) {
      f.addEventListener('click', () => {
        filter = f.dataset.filter!;
        for (const g of filters) g.setAttribute('aria-pressed', String(g === f));
        apply();
      });
    }
    q?.addEventListener('input', apply);

    const mini = root.querySelector<HTMLElement>('[data-mini]');
    const miniImg = root.querySelector<HTMLImageElement>('[data-mini-img]');
    const miniName = root.querySelector<HTMLElement>('[data-mini-name]');
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-theme]')];
    for (const card of cards) {
      card.addEventListener('click', () => {
        if (card.classList.contains('is-on')) return;
        for (const c of cards) {
          const on = c === card;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        }
        if (mini) {
          for (const k of ['--t-bg', '--t-fg', '--t-ac', '--t-bl', '--t-rd', '--t-ov']) {
            mini.style.setProperty(k, card.style.getPropertyValue(k));
          }
          mini.setAttribute('aria-label', `Preview of the theme in use: ${card.dataset.theme}`);
        }
        if (miniImg) {
          const src = card.dataset.img;
          miniImg.hidden = !src;
          if (src) miniImg.src = src;
          else miniImg.removeAttribute('src');
        }
        if (miniName) miniName.textContent = card.dataset.theme!;
      });
    }

    // ---- auto-play, until the visitor touches anything (same rules as the Modes section) ----
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const field = root.querySelector<HTMLElement>('.tc-field');
    const nameEl = root.querySelector<HTMLElement>('[data-tc-name]');
    const phEl = root.querySelector<HTMLElement>('[data-tc-ph]');
    const setName = (t: string) => {
      if (nameEl) nameEl.textContent = t;
      if (phEl) phEl.hidden = !!t; // the field's placeholder: an empty name saves as "Custom Theme"
    };
    // Custom | From image
    const wrap = root.querySelector<HTMLElement>('[data-tcm]');
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-tcm-set]')];
    const setCreatorMode = (m: string) => {
      if (wrap) wrap.dataset.tcm = m;
      for (const b of modeBtns) b.setAttribute('aria-pressed', String(b.dataset.tcmSet === m));
    };
    for (const b of modeBtns) b.addEventListener('click', () => setCreatorMode(b.dataset.tcmSet!));
    // the accent the demo edits: its swatch, its hex field and the preview's tab underline
    const acSw = root.querySelector<HTMLElement>('[data-tc-sw="ac"]');
    const acHex = root.querySelector<HTMLElement>('[data-tc-hex="ac"]');
    const prev = root.querySelector<HTMLElement>('[data-tc-prev]');
    const setAccent = (hex: string) => {
      acSw?.style.setProperty('--c', hex);
      if (acHex) acHex.textContent = hex;
      prev?.style.setProperty('--pac', hex);
    };
    const STOCK_ACCENT = '#ff7a18';
    const DEMO_ACCENTS = ['#6aa8ff', '#7bd88f', '#ff6ac1'];
    const DEMO_CARDS = ['Dark City', 'Dracula', 'Cyber Wave', 'Gruvbox Light'];
    const DEMO_NAMES = ['Ember Night', 'Harbor Fog', 'Copper Moss'];
    const T = { explore: 7600, create: 7200 };
    let auto = !reduce;
    let inView = false;
    let started = false;
    let wake: (() => void) | null = null;
    let round = 0;
    let typing = ''; // the name being typed, finished at once if the visitor stops the demo
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const waitView = () => (inView ? Promise.resolve() : new Promise<void>((r) => (wake = r)));

    const time = (id: string, ms: number) => {
      for (const p of picks) {
        p.classList.remove('is-timing');
        if (p.dataset.pick === id) {
          p.style.setProperty('--dur', `${ms}ms`);
          void p.offsetWidth;
          p.classList.add('is-timing');
        }
      }
    };
    const stopAuto = () => {
      if (!auto) return;
      auto = false;
      root.classList.remove('is-auto');
      for (const p of picks) p.classList.remove('is-timing');
      field?.classList.remove('is-typing');
      acHex?.classList.remove('is-edit');
      if (typing) setName(typing);
    };

    const loop = async () => {
      root.classList.add('is-auto');
      while (auto) {
        // the gallery: wait, then pick a theme so the preview recolours
        show('explore');
        time('explore', T.explore);
        await sleep(2600);
        if (!auto) return;
        const card = cards.find((c) => c.dataset.theme === DEMO_CARDS[round % DEMO_CARDS.length]);
        if (card) {
          card.classList.remove('is-tap');
          void card.offsetWidth;
          card.classList.add('is-tap');
          card.click();
        }
        await sleep(T.explore - 2600);
        if (!auto) return;
        await waitView();
        if (!auto) return;
        // the creator: type a name, then change the accent and watch the preview follow
        setCreatorMode('custom');
        setName('');
        setAccent(STOCK_ACCENT);
        show('create');
        time('create', T.create);
        if (nameEl && field) {
          typing = DEMO_NAMES[round % DEMO_NAMES.length];
          await sleep(900);
          if (!auto) return;
          field.classList.add('is-typing');
          let typed = '';
          for (const ch of typing) {
            if (!auto) return;
            typed += ch;
            setName(typed);
            await sleep(70 + Math.random() * 60);
          }
          typing = '';
          field.classList.remove('is-typing');
          await sleep(700);
          if (!auto) return;
          acHex?.classList.add('is-edit');
          setAccent(DEMO_ACCENTS[round % DEMO_ACCENTS.length]);
          await sleep(900);
          acHex?.classList.remove('is-edit');
          await sleep(Math.max(0, T.create - 900 - 1300 - 700 - 900));
        } else {
          await sleep(T.create);
        }
        if (!auto) return;
        await waitView();
        round++;
      }
    };

    for (const p of picks) {
      p.querySelector('button')?.addEventListener('click', () => {
        stopAuto();
        show(p.dataset.pick!);
      });
    }
    // any touch or keyboard focus anywhere in the section (picks, pages, preview) hands over control
    const stage = root.querySelector<HTMLElement>('.th-stage');
    root.addEventListener('pointerdown', stopAuto);
    root.addEventListener('focusin', stopAuto);

    if (auto && stage) {
      new IntersectionObserver(
        ([e]) => {
          inView = e.isIntersecting;
          if (inView && wake) {
            wake();
            wake = null;
          }
          if (inView && !started) {
            started = true;
            loop();
          }
        },
        { threshold: 0.4 },
      ).observe(stage);
    }
  }
</script>
