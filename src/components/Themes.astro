  /* ---------------- creator (theme_creator_body.rs, uncaged-0.3) ---------------- */
  /* the page is wider than other Settings pages: the app fills up to 1080px, so the gallery runs 4 up
     and the creator has room for its two columns */
  :global(.sw-win.tw .sw-main > .sw-page) {
