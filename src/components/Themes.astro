---
import AppIcon from './AppIcon.astro';
import SettingsWindow from './SettingsWindow.astro';

/**
 * 04 · themes. Hand-built recreations of Uncaged's Settings → Theme gallery
 * and Settings → Theme creator, matched to the captures of the current app
 * shots-in/v2/gallery-top.png, gallery.png and creator.png. The two picks swap
 * which page is shown (a crossfade); without JS both are shown, stacked. On
 * screen, it plays itself until the visitor touches it: a bar fills the active
 * pick, the gallery picks a theme (the mini preview recolours), then the creator
 * types a name. Reduced motion: no auto-play.
 *
 * Every theme value is from tag v0.3.3:
 *   names                      app/src/themes/theme.rs:117-147 (Display)
 *   background / text / accent app/src/themes/default_themes.rs (WarpTheme::new per theme)
 *   ANSI blue / red            the same file's *_NORMAL_COLORS
 *   background images          app/assets/async/jpg/thumbs/*  (copied to public/shots/themes/)
 *   card preview               app/src/themes/theme.rs:665 render_preview (190x100 at 1.2x,
 *                              "ls" / "dir   executable   file", outline rule, accent cursor,
 *                              theme background at (100 - image opacity)% over the image)
 *   card, filters, empty text  app/src/themes/theme_explorer_body.rs
 *   creator fields + defaults  app/src/themes/theme_creator_body.rs:54-74, 1241-1490
 * "Uncaged Midnight" is the custom theme in use on the captured install (a
 * "Yours" theme, ~/.uncaged/themes/uncaged-midnight.yaml); it is the window
 * colour of every recreation on this site. The community gallery is empty,
 * so "Available" shows the app's own empty text.
 */

type Theme = {
  name: string;
  origin: 'System' | 'Yours';
  /** theme background: a colour or the vertical gradient top → bottom */
  bg: string;
  fg: string;
  /** accent (the preview cursor); a horizontal gradient for a few themes */
  accent: string;
  blue: string;
  red: string;
  /** bundled background image (thumbnail) and its opacity, 0-100 */
  img?: string;
  imgOpacity?: number;
};

const v = (top: string, bottom: string) => `linear-gradient(180deg, ${top}, ${bottom})`;
const h = (left: string, right: string) => `linear-gradient(90deg, ${left}, ${right})`;
// Normal blue / red of each ANSI set in default_themes.rs.
const DARK_MODE = { blue: '#A5D5FE', red: '#FF8272' };
const LIGHT_MODE = { blue: '#008EC4', red: '#C30771' };
const DRACULA = { blue: '#BD93F9', red: '#FF5555' };
const SOLARIZED = { blue: '#268BD2', red: '#DC322F' };
const GRUVBOX = { blue: '#458588', red: '#CC241D' };

// Sorted as the explorer sorts them: System before Yours, then by name.
const THEMES: Theme[] = [
  { name: 'Adeberry', origin: 'System', bg: '#1D2022', fg: '#E4EEF5', accent: '#6C96B4', blue: '#5785C7', red: '#C76156' },
  // black blended with #00C2FF at 20%, down to black
  { name: 'Cyber Wave', origin: 'System', bg: v('#002733', '#000000'), fg: '#FFFFFF', accent: h('#007972', '#7B008F'), ...DARK_MODE },
  { name: 'Dark', origin: 'System', bg: '#000000', fg: '#FFFFFF', accent: '#19AAD8', ...DARK_MODE },
  // #01181F blended with #1A363F / #1A4551 at 45%
  { name: 'Dark City', origin: 'System', bg: v('#0C252D', '#0C2C36'), fg: '#FFFFFF', accent: '#E9072D', ...DARK_MODE, img: 'dark-city', imgOpacity: 20 },
  { name: 'Dracula', origin: 'System', bg: '#282A36', fg: '#F8F8F2', accent: '#FF79C6', ...DRACULA },
  { name: 'Fancy Dracula', origin: 'System', bg: v('#252630', '#3D3F4F'), fg: '#FFFFFF', accent: h('#BCA1F6', '#A3E7FC'), ...DRACULA },
  { name: 'Gruvbox Dark', origin: 'System', bg: '#282828', fg: '#EBDBB2', accent: '#FC802D', ...GRUVBOX },
  { name: 'Gruvbox Light', origin: 'System', bg: '#FBF1C7', fg: '#3C3836', accent: '#AD3B14', ...GRUVBOX },
  { name: 'Jellyfish', origin: 'System', bg: '#1B1718', fg: '#FFFFFF', accent: '#538682', ...DARK_MODE, img: 'jellyfish', imgOpacity: 30 },
  { name: 'Koi', origin: 'System', bg: '#211719', fg: '#FFFFFF', accent: '#FF3131', ...DARK_MODE, img: 'koi', imgOpacity: 30 },
  { name: 'Leafy', origin: 'System', bg: '#000000', fg: '#FFFFFF', accent: '#55972D', ...DARK_MODE, img: 'leafy', imgOpacity: 30 },
  { name: 'Light', origin: 'System', bg: '#FFFFFF', fg: '#111111', accent: '#00C2FF', ...LIGHT_MODE },
  { name: 'Marble', origin: 'System', bg: '#E3E3E3', fg: '#000000', accent: '#585858', ...LIGHT_MODE, img: 'marble', imgOpacity: 50 },
  { name: 'Midnight', origin: 'System', bg: v('#12151D', '#0B0D12'), fg: '#E8EBF2', accent: '#FF7A18', blue: '#6AA8FF', red: '#F06A78' },
  { name: 'Phenomenon', origin: 'System', bg: '#121212', fg: '#FAF9F6', accent: '#2E5D9E', blue: '#3780E9', red: '#D22D1E', img: 'phenomenon', imgOpacity: 100 },
  { name: 'Pink City', origin: 'System', bg: '#FBEFF6', fg: '#000000', accent: '#E10087', ...LIGHT_MODE, img: 'pink-city', imgOpacity: 40 },
  // #211719 blended with #4C3435 / #0D3032 at 45%
  { name: 'Red Rock', origin: 'System', bg: v('#342425', '#182224'), fg: '#FFFFFF', accent: '#9F4147', ...DARK_MODE, img: 'red-rock', imgOpacity: 30 },
  { name: 'Snowy', origin: 'System', bg: v('#FFFFFF', '#DEE6EB'), fg: '#000000', accent: '#647E90', ...LIGHT_MODE, img: 'snowy', imgOpacity: 20 },
  { name: 'Solar Flare', origin: 'System', bg: '#1B1C18', fg: '#DDE6EE', accent: '#34895C', blue: '#5C80B2', red: '#D66060', img: 'solarflare', imgOpacity: 20 },
  { name: 'Solarized Dark', origin: 'System', bg: '#002B36', fg: '#F8F8F2', accent: '#CB4B16', ...SOLARIZED },
  { name: 'Solarized Light', origin: 'System', bg: '#FDF6E3', fg: '#586E75', accent: '#66B5A9', ...SOLARIZED },
  { name: 'Uncaged', origin: 'System', bg: v('#15110C', '#0C0A08'), fg: '#E9E1D4', accent: '#FF7A18', blue: '#74B4E0', red: '#FF6B5E' },
  { name: 'Willow Dream', origin: 'System', bg: v('#206169', '#022F27'), fg: '#FFFFFF', accent: h('#F9AEA8', '#DD6258'), ...DARK_MODE },
  { name: 'Uncaged Midnight', origin: 'Yours', bg: v('#12151d', '#0b0d12'), fg: '#e8ebf2', accent: '#ff7a18', blue: '#5aa6ff', red: '#ff5e10' },
];
const IN_USE = 'Uncaged Midnight';
const FILTERS = ['All', 'System', 'Downloaded', 'Yours', 'Available'];

const vars = (t: Theme) =>
  [
    `--t-bg:${t.bg}`,
    `--t-fg:${t.fg}`,
    `--t-ac:${t.accent}`,
    `--t-bl:${t.blue}`,
    `--t-rd:${t.red}`,
    `--t-ov:${(100 - (t.img ? (t.imgOpacity ?? 0) : 0)) / 100}`,
  ].join(';');
const imgSrc = (t: Theme) => (t.img ? `/shots/themes/${t.img}.webp` : '');
const inUse = THEMES.find((t) => t.name === IN_USE)!;

// theme_creator_body.rs (uncaged-0.3) DEFAULTS — the editor opens on the Uncaged palette.
const CARD_COLORS = [
  { k: 'bg', l: 'Background', v: '#15110c' },
  { k: 'fg', l: 'Text', v: '#e9e1d4' },
  { k: 'ac', l: 'Accent', v: '#ff7a18' },
  { k: 'cur', l: 'Cursor', v: '#ffb23a' },
];
type Pal = { bg: string; bg2: string; fg: string; dim: string; ac: string; cur: string; rule: string; n: string[]; b: string[] };
const UNCAGED_PAL: Pal = {
  bg: '#15110c', bg2: '#0c0a08', fg: '#e9e1d4', dim: '#88837b', ac: '#ff7a18', cur: '#ffb23a', rule: '#34312c',
  n: ['#4a443b', '#ff6b5e', '#8fd46e', '#ffc24a', '#74b4e0', '#f090c0', '#5fc9be', '#e9e1d4'],
  b: ['#6e655a', '#ff8a76', '#b2e38c', '#ffd46e', '#9bcbee', '#f7abd6', '#86ded0', '#fbf6ec'],
};
// "this is your current look": Uncaged Midnight, from ~/.uncaged/themes/uncaged-midnight.yaml
// (dim text and the tab rule sampled from shots-in/v2/v3-fromimage.png)
const MIDNIGHT_PAL: Pal = {
  bg: '#12151d', bg2: '#0b0d12', fg: '#e8ebf2', dim: '#878a90', ac: '#ff7a18', cur: '#ff7a18', rule: '#34363d',
  n: ['#171b24', '#ff5e10', '#4fd493', '#ffb23a', '#5aa6ff', '#b98cff', '#54d6c4', '#8b93a5'],
  b: ['#5d6577', '#ff7a18', '#7fe9b4', '#ffd166', '#8cc2ff', '#d0b0ff', '#82e9db', '#e8ebf2'],
};
// render_preview(): tabs "~/uncaged" | "zsh", git status, ls, a warning, the normal and bright
// colour chips, and the prompt with the cursor (theme_creator_body.rs:2660-2775)
const preview = (p: Pal, live = false) => {
  const pr = (cmd: string) => `<span style="color:var(--p4)">~/uncaged</span><span style="color:var(--p5)"> main</span><span style="color:var(--p2)"> ❯ </span>${cmd}`;
  const chips = (cs: string[], first = false) => `<span class="pt-chips${first ? ' pt-c1' : ''}">${cs.map((c) => `<i style="background:${c}"></i>`).join('')}</span>`;
  return `<span class="pt"${live ? ' data-tc-prev' : ''} style="--pbg:${p.bg};--pbg2:${p.bg2};--pfg:${p.fg};--pdim:${p.dim};--pac:${p.ac};--pcur:${p.cur};--prule:${p.rule};${p.n.map((c, i) => `--p${i}:${c}`).join(';')}">`
    + `<span class="pt-tabs"><span class="pt-tab is-on">~/uncaged</span><span class="pt-tab">zsh</span></span>`
    + `<span class="pt-l">${pr('git status')}</span>`
    + `<span class="pt-l">On branch main</span>`
    + `<span class="pt-l" style="color:var(--p1)">  modified:  src/theme.rs</span>`
    + `<span class="pt-l" style="color:var(--p2)">  new file:  themes/ember.yaml</span>`
    + `<span class="pt-l">${pr('ls')}</span>`
    + `<span class="pt-l"><span style="color:var(--p4)">app  crates  </span><span style="color:var(--p2)">run.sh  </span>README.md</span>`
    + `<span class="pt-l"><span style="color:var(--p3)">warning: </span>1 commit to push</span>`
    + chips(p.n, true) + chips(p.b)
    + `<span class="pt-l pt-cl">${pr('')}<i class="pt-cur"></i></span>`
    + `</span>`;
};
const PREVIEW = preview(UNCAGED_PAL, true);
const PREVIEW_CURRENT = preview(MIDNIGHT_PAL);

const picks = [
  {
    id: 'explore',
    label: 'Theme gallery',
    body: 'Filter by All, System, Downloaded, Yours or Available. Every card is a live preview of the theme; <b class="kw">Use</b> applies it.',
  },
  {
    id: 'create',
    label: 'Theme creator',
    body: 'Name it, set the background (a gradient or a picture), text, accent and cursor colours, and Dark or Light, with a live terminal preview beside it. All 16 terminal colours sit under Advanced. Or start <b>From image</b>: pick a picture and it pulls the palette out of it.',
  },
];
---

<section class="section themes" id="themes" aria-labelledby="themes-h">
  <div class="container">
    <span class="sec-tag"><b>04</b> themes</span>

    <header class="t-head">
      <h2 class="h2" id="themes-h">Make it<br /><span class="dim">yours</span><span class="ember">.</span></h2>
      <p class="lede">
        <strong>23 built-in themes</strong>, with Uncaged as the default. Pick one, or make your own and share it.
      </p>
    </header>

    <div class="th" data-th>
      <div class="th-picks">
        {
          picks.map((p) => (
            <div class="th-pick" data-pick={p.id}>
              <button type="button" class="th-btn" aria-controls={`th-shot-${p.id}`}>
                {p.label}
              </button>
              <p class="th-body" set:html={p.body} />
            </div>
          ))
        }
        <p class="th-share">
          <b class="kw">Share with the community</b> opens a pull request to the community gallery,
          <a href="https://github.com/getuncaged/uncaged-themes" rel="noopener">getuncaged/uncaged-themes</a>. There
          are no community themes in it yet, so <b>Available</b> is empty.
        </p>

        <!-- The theme in use, drawn the way the app draws its preview. -->
        <figure class="mini" data-mini style={vars(inUse)} aria-label={`Preview of the theme in use: ${inUse.name}`}>
          <div class="mini-win" aria-hidden="true">
            <span class="mini-bar"><i></i><i></i><i></i></span>
            <span class="tp mini-tp">
              <img class="tp-img" data-mini-img src={imgSrc(inUse) || undefined} alt="" hidden={!inUse.img} />
              <span class="tp-l1">ls</span>
              <span class="tp-l2"><i class="b">{'dir\u00a0\u00a0\u00a0'}</i><i class="r">{'executable\u00a0\u00a0\u00a0'}</i><i>file</i></span>
              <span class="tp-in"><i class="tp-cur"></i></span>
            </span>
          </div>
          <figcaption class="mini-cap">In use: <b data-mini-name>{inUse.name}</b></figcaption>
        </figure>
      </div>

      <div class="th-stage">
        <!-- Settings → Theme gallery (shots-in/v2/gallery-top.png) -->
        <div class="th-shot is-on" id="th-shot-explore" data-shot="explore">
          <SettingsWindow page="Theme gallery" label="Theme gallery settings page, scrollable" class="tw">
            <p class="sw-title tp-h">Theme gallery</p>
            <p class="tp-sub">Explore themes</p>
            <label class="tx-search">
              <AppIcon name="find" size={12} />
              <input type="text" data-q aria-label="Search themes" autocomplete="off" spellcheck="false" />
            </label>
            <div class="tx-filters" role="group" aria-label="Filter themes">
              {
                FILTERS.map((f, i) => (
                  <button type="button" class="tbtn tbtn-s" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
                    {f}
                  </button>
                ))
              }
            </div>
            <ul class="tx-grid" data-grid aria-label="Themes">
              {
                THEMES.map((t) => (
                  <li data-origin={t.origin} data-name={t.name.toLowerCase()}>
                    <button
                      type="button"
                      class={`tx-card${t.name === IN_USE ? ' is-on' : ''}`}
                      data-theme={t.name}
                      data-img={imgSrc(t)}
                      style={vars(t)}
                      aria-pressed={t.name === IN_USE ? 'true' : 'false'}
                      aria-label={`${t.name}, ${t.origin}`}
                    >
                      <span class="tp" aria-hidden="true">
                        {t.img && <img class="tp-img" src={imgSrc(t)} alt="" loading="lazy" decoding="async" width="380" height="200" />}
                        <span class="tp-l1">ls</span>
                        <span class="tp-l2"><i class="b">{'dir\u00a0\u00a0\u00a0'}</i><i class="r">{'executable\u00a0\u00a0\u00a0'}</i><i>file</i></span>
                        <span class="tp-in">
                          <i class="tp-cur" />
                        </span>
                      </span>
                      <span class="tx-foot" aria-hidden="true">
                        <span class="tx-name">{t.name}</span>
                        <span class="tx-use">Use</span>
                        <span class="tx-inuse">In use</span>
                      </span>
                      <span class="tx-origin" aria-hidden="true">{t.origin}</span>
                    </button>
                  </li>
                ))
              }
            </ul>
            <p class="tx-empty" data-empty hidden>No themes match that search.</p>
          </SettingsWindow>
        </div>

        <!-- Settings → Theme creator, redesigned (shots-in/v2/v3-creator*.png, v3-fromimage.png;
             app/src/themes/theme_creator_body.rs on uncaged-0.3): the Custom | From image switch, section
             cards beside a live terminal preview, and Cancel · Save theme · Share with the community under
             it. Below the app's two-column width it stacks: preview, controls, then the actions. -->
        <div class="th-shot" id="th-shot-create" data-shot="create">
          <SettingsWindow page="Theme creator" label="Theme creator settings page, scrollable" class="tw">
            <p class="sw-title tp-h" aria-hidden="true">Theme creator</p>
            <p class="tp-sub" aria-hidden="true">Create your own custom theme</p>
            <div class="tc-seg" role="group" aria-label="Theme creator mode">
              <button type="button" class="tc-sb" data-tcm-set="custom" aria-pressed="true">Custom</button>
              <button type="button" class="tc-sb" data-tcm-set="image" aria-pressed="false">From image</button>
            </div>

            <div class="tc-wrap" data-tcm="custom">
              <!-- ===== Custom ===== -->
              <div class="tc tc-custom" aria-hidden="true">
                <div class="tc-ctl">
                  <div class="sw-card tc-card">
                    <span class="tc-ct">Name</span>
                    <span class="tc-field"><span class="tc-ph" data-tc-ph>Custom Theme</span><span data-tc-name></span><i class="tc-caret"></i></span>
                  </div>
                  <div class="sw-card tc-card">
                    <span class="tc-ct">Colors</span>
                    {
                      CARD_COLORS.map((c) => (
                        <span class="tc-row">
                          <span class="tc-rl">{c.l}</span>
                          <span class="tc-sw" style={`--c:${c.v}`} data-tc-sw={c.k} />
                          <span class="tc-hex" data-tc-hex={c.k}>{c.v}</span>
                        </span>
                      ))
                    }
                  </div>
                  <div class="sw-card tc-card">
                    <span class="tc-ct">Background</span>
                    <span class="tc-row">
                      <span class="tc-rt"><span class="tc-rl">Gradient</span><span class="tc-rd">Fade the background from its color at the top to another at the bottom.</span></span>
                      <span class="tc-tog"><i></i></span>
                    </span>
                    <span class="tc-row">
                      <span class="tc-rl">Bottom color</span>
                      <span class="tc-sw" style="--c:#0c0a08" />
                      <span class="tc-hex">#0c0a08</span>
                    </span>
                    <span class="tc-row">
                      <span class="tc-rl">Opacity</span>
                      <span class="tc-slider" style="--v:1"><i></i></span>
                      <span class="tc-val">100%</span>
                    </span>
                    <span class="tc-row">
                      <span class="tc-rt"><span class="tc-rl">Image</span><span class="tc-rd">A picture behind the terminal, under the background color.</span></span>
                      <span class="tbtn tbtn-s tc-btn">Add image…</span>
                    </span>
                  </div>
                  <div class="sw-card tc-card">
                    <span class="tc-ct">Window<span class="tc-cd">Applies to every window right away. Not saved with the theme.</span></span>
                    <span class="tc-row">
                      <span class="tc-rl">Opacity</span>
                      <span class="tc-slider" style="--v:1"><i></i></span>
                      <span class="tc-val">100%</span>
                    </span>
                    <span class="tc-row">
                      <span class="tc-rl">Blur radius</span>
                      <span class="tc-slider" style="--v:0.32"><i></i></span>
                      <span class="tc-val">21</span>
                    </span>
                  </div>
                  <div class="sw-card tc-card">
                    <span class="tc-ct">Appearance</span>
                    <span class="tc-row">
                      <span class="tc-rt"><span class="tc-rl">Style</span><span class="tc-rd">Tunes the contrast of menus and panels for a dark or light background.</span></span>
                      <span class="tc-mini-seg"><span class="is-on">Dark</span><span>Light</span></span>
                    </span>
                  </div>
                  <div class="sw-card tc-card tc-adv">
                    <span class="tc-rt"><span class="tc-ct">Advanced</span><span class="tc-rd">The 16 colors programs use in the terminal: errors, git status, ls, prompts.</span></span>
                    <AppIcon name="chevron-right" size={14} />
                  </div>
                </div>
                <div class="sw-card tc-prev">
                  <span class="tc-ct">Preview<span class="tc-cd">Updates as you edit.</span></span>
                  <Fragment set:html={PREVIEW} />
                </div>
                <div class="tc-actions">
                  <span class="tbtn tbtn-s">Cancel</span>
                  <span class="tbtn tbtn-s">Save theme</span>
                  <span class="tbtn tbtn-a">Share with the community</span>
                </div>
              </div>

              <!-- ===== From image: three numbered steps ===== -->
              <div class="tc tc-image" aria-hidden="true">
                <div class="tc-ctl">
                  <div class="sw-card tc-card tc-step">
                    <span class="tc-n">1</span>
                    <span class="tc-rt">
                      <span class="tc-ct">Choose an image</span>
                      <span class="tc-rd">Uncaged pulls a background, text, accent and the 16 terminal colors out of the image. You can tweak every color afterwards.</span>
                    </span>
                    <span class="tc-row tc-step-row">
                      <span class="tc-rl tc-dim">No image yet (.png or .jpg)</span>
                      <span class="tbtn tbtn-s tc-btn"><AppIcon name="upload-01" size={12} />Choose image…</span>
                    </span>
                  </div>
                  <div class="sw-card tc-card tc-step is-off">
                    <span class="tc-n">2</span>
                    <span class="tc-rt">
                      <span class="tc-ct">Pick a background</span>
                      <span class="tc-rd">Choose an image first. Its main colors show up here to pick from.</span>
                    </span>
                  </div>
                  <div class="sw-card tc-card tc-step is-off">
                    <span class="tc-n">3</span>
                    <span class="tc-rt">
                      <span class="tc-ct">Fine-tune</span>
                      <span class="tc-rd">Once your image is read, name the theme or change any of its colors.</span>
                    </span>
                  </div>
                </div>
                <div class="sw-card tc-prev">
                  <span class="tc-ct">Preview<span class="tc-cd">Choose an image to see the theme it makes. Until then, this is your current look.</span></span>
                  <Fragment set:html={PREVIEW_CURRENT} />
                </div>
                <div class="tc-actions">
                  <span class="tbtn tbtn-s">Cancel</span>
                  <span class="tbtn tbtn-s is-dis">Create theme</span>
                </div>
              </div>
            </div>
          </SettingsWindow>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .t-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .kw {
    font: 700 0.86em/1 var(--mono);
    color: var(--ink);
    padding: 2px 6px;
    border: 1px solid var(--bar);
    border-radius: 5px;
    white-space: nowrap;
  }

  .th {
    display: grid;
    grid-template-columns: minmax(250px, 300px) minmax(0, 1fr);
    gap: clamp(28px, 3vw, 48px);
    align-items: start;
  }
  .th-picks {
    display: grid;
    gap: 8px;
  }
  .th-pick {
    position: relative;
    padding: 18px 0 18px 20px;
    border-left: 2px solid var(--rule-strong);
    transition: border-color 0.3s var(--ease);
  }
  /* auto-play: the active pick's rule fills while its page is on, like a timer */
  .th-pick::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 0;
