  }
  .th.is-js .th-pick.is-on {
    border-left-color: var(--ember);
  }
  .th.is-js .th-stage {
    gap: 0;
  }
  .th.is-js .th-shot {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
