  /* ---------------------------------------------- the settings pages
     Sizes from theme_explorer_body.rs / theme_creator_body.rs; colours
     measured from the captures. */
  :global(.sw-win.tw) {
    --sw-h: clamp(630px, 46vw, 680px);
  }
  .tp-h {
